<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_live_more"
    android:layout_width="match_parent"
    android:layout_height="802mm">
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32mm"
        android:layout_marginBottom="18mm"
        android:text="@string/recharge"
        android:layout_marginStart="28mm"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rlv_pay_money"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28mm"
        android:layout_marginEnd="28mm"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rlv_pay_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="39mm"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/res_main_color"
            android:gravity="center"
            android:id="@+id/tv_recharge"
            android:background="@drawable/bg_base_r44"
            android:layout_width="match_parent"
            android:layout_height="88mm"
            android:layout_marginBottom="48mm"
            android:text="@string/recharge"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="40mm"
            android:layout_marginEnd="40mm"/>
    </RelativeLayout>
</LinearLayout>
