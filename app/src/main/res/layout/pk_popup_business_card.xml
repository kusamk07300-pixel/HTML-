<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@mipmap/live_user_popup_bj"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/image_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.yy.yyeva.view.EvaAnimViewV3
        android:id="@+id/ev_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120mm">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:visibility="invisible"
                android:layout_width="64mm"
                android:layout_height="80mm"
                android:layout_marginTop="24mm"
                android:layout_marginStart="24mm">
                <ImageView
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:src="@mipmap/image_value"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffe37e"
                    android:gravity="center"
                    android:id="@+id/tv_likes"
                    android:background="@mipmap/iamge_dzbj"
                    android:layout_width="64mm"
                    android:layout_height="28mm"
                    android:text="0"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/image_question"
                android:visibility="gone"
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:layout_marginTop="24mm"
                android:src="@mipmap/iamge_question"
                android:layout_marginEnd="24mm"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:visibility="gone"
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:layout_marginTop="24mm"
                android:src="@mipmap/iamge_information"
                android:layout_marginEnd="20mm"
                android:layout_toStartOf="@+id/image_question"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_identity"
                android:visibility="gone"
                android:layout_width="40mm"
                android:layout_height="40mm"
                android:layout_marginEnd="5mm"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="昵称"
                android:maxLines="1"/>
            <ImageView
                android:id="@+id/iv_auth"
                android:visibility="gone"
                android:layout_width="60mm"
                android:layout_height="60mm"
                android:src="@mipmap/official_auth"
                android:layout_marginStart="10mm"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15mm">
            <ImageView
                android:id="@+id/image_id"
                android:visibility="gone"
                android:layout_width="64mm"
                android:layout_height="34mm"
                android:layout_marginEnd="8mm"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#ff333333"
                    android:id="@+id/tv_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID："
                    android:drawablePadding="8mm"
                    android:drawableEnd="@mipmap/iamge_copy1"
                    android:fontFamily="sans-serif-medium"/>
                <View
                    android:background="#999999"
                    android:layout_width="2mm"
                    android:layout_height="28mm"
                    android:layout_marginStart="12mm"
                    android:layout_marginEnd="12mm"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/iv_iso"
                android:visibility="gone"
                android:layout_width="28mm"
                android:layout_height="20mm"
                android:scaleType="fitXY"
                android:layout_marginEnd="10mm"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ff333333"
                android:id="@+id/tv_country"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15mm">
            <ImageView
                android:id="@+id/iv_vip"
                android:layout_width="wrap_content"
                android:layout_height="32mm"
                android:layout_marginEnd="12mm"/>
            <ImageView
                android:id="@+id/iv_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12mm"/>
            <ImageView
                android:id="@+id/iv_level_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12mm"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center"
            android:id="@+id/re_medal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15mm"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/lin_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm">
            <ImageView
                android:id="@+id/badge_empty1"
                android:layout_width="64mm"
                android:layout_height="64mm"
                android:src="@mipmap/medal_empty"
                android:layout_marginEnd="16mm"/>
            <ImageView
                android:id="@+id/badge1"
                android:visibility="gone"
                android:layout_width="64mm"
                android:layout_height="64mm"
                android:layout_marginEnd="16mm"/>
            <com.yy.yyeva.view.EvaAnimViewV3
                android:id="@+id/ev_badge1"
                android:visibility="gone"
                android:layout_width="64mm"
                android:layout_height="64mm"
                android:layout_marginEnd="16mm"/>
            <ImageView
                android:id="@+id/badge_empty2"
                android:layout_width="64mm"
                android:layout_height="64mm"
                android:src="@mipmap/medal_empty"
                android:layout_marginEnd="16mm"/>
            <ImageView
                android:id="@+id/badge2"
                android:visibility="gone"
                android:layout_width="64mm"
                android:layout_height="64mm"
                android:layout_marginEnd="16mm"/>
            <com.yy.yyeva.view.EvaAnimViewV3
                android:id="@+id/ev_badge2"
                android:visibility="gone"
                android:layout_width="64mm"
                android:layout_height="64mm"
                android:layout_marginEnd="16mm"/>
            <ImageView
                android:id="@+id/badge_empty3"
                android:layout_width="64mm"
                android:layout_height="64mm"
                android:src="@mipmap/medal_empty"/>
            <ImageView
                android:id="@+id/badge3"
                android:visibility="gone"
                android:layout_width="64mm"
                android:layout_height="64mm"/>
            <com.yy.yyeva.view.EvaAnimViewV3
                android:id="@+id/ev_badge3"
                android:visibility="gone"
                android:layout_width="64mm"
                android:layout_height="64mm"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@mipmap/user_pk_bj"
                android:visibility="gone"
                android:layout_width="192mm"
                android:layout_height="64mm">
                <ImageView
                    android:id="@+id/image_pk"
                    android:layout_width="40mm"
                    android:layout_height="40mm"
                    android:layout_margin="12mm"
                    android:src="@mipmap/pk_icon"/>
                <RatingBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:rating="3"
                    android:stepSize="1"
                    style="@style/myRatingBar"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm"
            android:text="@string/my_relationship"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm"
            android:layout_marginBottom="40mm">
            <TextView
                android:textSize="13dp"
                android:textColor="#ff999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无守护关系/无守护"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ff57adfe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="了解守护&gt;"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="20mm"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lin_guard"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm">
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/re_guard3"
                android:visibility="gone"
                android:layout_width="80mm"
                android:layout_height="90mm"
                android:layout_marginEnd="40mm">
                <ImageView
                    android:id="@+id/imgs_guard_avatar3"
                    android:layout_width="80mm"
                    android:layout_height="80mm"
                    android:src="@mipmap/circle_logo"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tv_num_guard3"
                    android:background="@drawable/live_profit_pink"
                    android:layout_width="match_parent"
                    android:layout_height="28mm"
                    android:text="LV1"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/re_guard2"
                android:visibility="gone"
                android:layout_width="80mm"
                android:layout_height="90mm"
                android:layout_marginEnd="40mm">
                <ImageView
                    android:id="@+id/imgs_guard_avatar2"
                    android:layout_width="80mm"
                    android:layout_height="80mm"
                    android:src="@mipmap/circle_logo"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tv_num_guard2"
                    android:background="@drawable/live_profit_pink"
                    android:layout_width="match_parent"
                    android:layout_height="28mm"
                    android:text="LV1"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/re_guard1"
                android:layout_width="80mm"
                android:layout_height="90mm">
                <ImageView
                    android:id="@+id/imgs_guard_avatar1"
                    android:layout_width="80mm"
                    android:layout_height="80mm"
                    android:src="@mipmap/circle_logo"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tv_num_guard1"
                    android:background="@drawable/live_profit_pink"
                    android:layout_width="match_parent"
                    android:layout_height="28mm"
                    android:text="LV1"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lin_function"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        android:layout_marginBottom="40mm"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/re_live"
            android:background="@drawable/bg_new_family_but"
            android:layout_width="match_parent"
            android:layout_height="100mm"
            android:layout_marginStart="30mm"
            android:layout_marginEnd="30mm">
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:drawableStart="@mipmap/pk_live"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="180mm"
        android:layout_marginTop="50mm"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:id="@+id/re_1"
            android:layout_width="180mm"
            android:layout_height="180mm">
            <net.babycat.live.platform.widget.view.CircleImageView xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/image_avatar1"
                android:layout_width="120mm"
                android:layout_height="120mm"
                android:src="@mipmap/circle_logo"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                app:civ_border_color="#ef5b90"
                app:civ_border_width="4mm"/>
            <ImageView
                android:id="@+id/svga_view"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.yy.yyeva.view.EvaAnimView
                android:id="@+id/ev_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/re_2"
            android:visibility="gone"
            android:layout_width="180mm"
            android:layout_height="180mm"
            android:layout_marginStart="20mm"
            android:layout_toEndOf="@+id/re_1">
            <net.babycat.live.platform.widget.view.CircleImageView
                android:id="@+id/image_avatar2"
                android:layout_width="120mm"
                android:layout_height="120mm"
                android:src="@mipmap/circle_logo"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                app:civ_border_color="#ef5b90"
                app:civ_border_width="4mm"/>
            <ImageView
                android:id="@+id/svga_view2"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/image_heart"
            android:visibility="gone"
            android:layout_width="120mm"
            android:layout_height="120mm"
            android:src="@mipmap/iamge_heart_rate"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
