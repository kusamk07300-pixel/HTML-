<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/page_top"
        layout="@layout/common_toolbar"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lin_friends"
        android:background="@drawable/bg_friends_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="88mm"
        android:layout_marginTop="10mm"
        android:layout_marginBottom="20mm"
        android:layout_marginStart="150mm"
        android:layout_marginEnd="150mm">
        <TextView
            android:textSize="16dp"
            android:textColor="#333"
            android:gravity="center"
            android:id="@+id/tv_friends"
            android:background="@drawable/bg_white_r40"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8mm"
            android:text="@string/friends"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/tv_pull_black"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8mm"
            android:text="@string/blocked_list"
            android:layout_weight="1"
            android:layout_marginStart="10mm"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/fl_friends"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
