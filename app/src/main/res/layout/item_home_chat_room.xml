<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="230mm"
    android:layout_marginBottom="16mm">
    <View
        android:background="@drawable/bg_white_r22"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="65mm"/>
    <FrameLayout
        android:id="@+id/ather"
        android:layout_width="184mm"
        android:layout_height="184mm"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/iv_header"
            android:layout_width="184mm"
            android:layout_height="184mm"
            android:src="@mipmap/voice_logo"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/image_pass"
            android:visibility="gone"
            android:layout_width="96mm"
            android:layout_height="96mm"
            android:src="@mipmap/image_pass"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_room_level"
        android:layout_width="80mm"
        android:layout_height="80mm"
        android:layout_marginTop="10mm"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="110mm"
        android:layout_marginEnd="10mm"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16mm"
        android:layout_toEndOf="@+id/ather">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm"
            android:text="Room name"
            android:lines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="20mm"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8mm">
            <TextView
                android:textSize="10dp"
                android:textColor="#666666"
                android:id="@+id/tv_room_id"
                android:background="@drawable/bg_room_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10mm"
                android:paddingEnd="10mm"
                android:layout_marginEnd="8mm"/>
            <ImageView
                android:id="@+id/image_country"
                android:layout_width="40mm"
                android:layout_height="26mm"
                android:layout_marginEnd="8mm"/>
            <ImageView
                android:id="@+id/iv_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/level_0"
                android:layout_marginEnd="8mm"/>
            <ImageView
                android:id="@+id/iv_level_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/level_author_0"
                android:layout_marginEnd="8mm"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#ffffffff"
                android:id="@+id/tv_language"
                android:background="@drawable/bg_language_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10mm"
                android:paddingEnd="10mm"
                android:layout_marginEnd="8mm"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/second_text_color"
            android:ellipsize="end"
            android:id="@+id/tv_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm"
            android:lines="2"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="14mm"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16mm">
            <ImageView
                android:id="@+id/iv_live"
                android:layout_width="36mm"
                android:layout_height="36mm"
                android:src="@mipmap/room_live"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12mm"
                android:layout_toStartOf="@+id/tv_user_count"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#9469d9"
                android:id="@+id/tv_user_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="24mm"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_hot"
        android:background="@drawable/bg_home_room_hot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40mm"
        android:layout_marginTop="28mm"
        android:text="0"
        android:drawablePadding="4mm"
        android:drawableStart="@mipmap/room_hot"
        android:paddingStart="12mm"
        android:paddingEnd="12mm"
        android:layout_marginEnd="20mm"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</RelativeLayout>
