<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#2c0508"
    android:paddingTop="@dimen/page_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:id="@+id/tv_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20mm"
        android:text="@string/quick_game"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20mm"
        android:text="@string/casual_games"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/re_casual_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/white"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20mm"
        android:text="@string/three_party_games"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/re_three_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
