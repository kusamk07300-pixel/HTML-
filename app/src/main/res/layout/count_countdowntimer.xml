<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="72mm"
    android:layoutDirection="ltr">
    <TextView
        android:id="@+id/tv_hour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00"
        style="@style/CountdownTimerViewStyle"/>
    <TextView
        android:textSize="14dp"
        android:background="@mipmap/rww_colon_bj"
        android:layout_width="11mm"
        android:layout_height="33mm"
        android:layout_marginStart="4mm"
        android:layout_marginEnd="4mm"/>
    <TextView
        android:id="@+id/tv_minute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00"
        style="@style/CountdownTimerViewStyle"/>
    <TextView
        android:textSize="14dp"
        android:background="@mipmap/rww_colon_bj"
        android:layout_width="11mm"
        android:layout_height="33mm"
        android:layout_marginStart="4mm"
        android:layout_marginEnd="4mm"/>
    <TextView
        android:id="@+id/tv_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00"
        style="@style/CountdownTimerViewStyle"/>
</LinearLayout>
