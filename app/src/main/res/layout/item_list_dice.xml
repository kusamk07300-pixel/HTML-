<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20mm">
    <ImageView
        android:id="@+id/image_identity"
        android:visibility="visible"
        android:layout_width="64mm"
        android:layout_height="64mm"
        android:src="@mipmap/circle_logo"
        android:layout_marginStart="28mm"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8mm"
        android:layout_toEndOf="@+id/image_identity">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lin_chat_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/tv_speak_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="普通用户昵称"
                    android:layout_toRightOf="@+id/image_identity"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12mm"
                android:layout_marginStart="4mm">
                <ImageView
                    android:id="@+id/image_vip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5mm"/>
                <ImageView
                    android:id="@+id/image_grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5mm"/>
                <ImageView
                    android:id="@+id/image_charm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/re_medal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8mm"
                android:layout_marginStart="4mm"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:textColorHighlight="#cccccc"
            android:gravity="center"
            android:id="@+id/tv_speak_content"
            android:padding="16mm"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10mm"
            android:adjustViewBounds="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="10mm"
            android:textIsSelectable="true"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:textColorHighlight="#cccccc"
            android:gravity="center"
            android:id="@+id/tv_speak_content_nine"
            android:padding="16mm"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10mm"
            android:adjustViewBounds="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="10mm"
            android:textIsSelectable="true"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</RelativeLayout>
