<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_top"
        android:layout_width="match_parent"
        android:layout_height="418mm"
        android:src="@mipmap/wallet_bg"
        android:scaleType="fitXY"/>
    <include
        android:id="@+id/view_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/page_top"
        layout="@layout/common_toolbar"/>
    <RelativeLayout
        android:id="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="418mm"
        android:layout_marginTop="24mm"
        android:layout_below="@+id/view_top"
        android:layout_marginStart="28mm"
        android:layout_marginEnd="28mm">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="418mm"
            android:src="@mipmap/bg_wallet_coin"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_width="114mm"
                android:layout_height="106mm"
                android:src="@mipmap/icon_diamond"/>
            <TextView
                android:textSize="32dp"
                android:textColor="@color/white"
                android:id="@+id/tv_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27mm"
                android:layout_marginBottom="20mm"
                android:text="0"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gold"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_withdrawal"
            android:background="@drawable/bg_login_google"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="82mm"
            android:layout_marginLeft="75mm"
            android:layout_marginRight="75mm"
            android:layout_marginBottom="20mm"
            android:text="@string/withdrawal"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_transfer"
            android:background="@drawable/bg_login_google"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="82mm"
            android:layout_marginLeft="75mm"
            android:layout_marginRight="75mm"
            android:layout_marginBottom="20mm"
            android:text="@string/transfer"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_exchange"
            android:background="@drawable/bg_login_google"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="82mm"
            android:layout_marginLeft="75mm"
            android:layout_marginRight="75mm"
            android:layout_marginBottom="40mm"
            android:text="@string/exchange"/>
    </LinearLayout>
</RelativeLayout>
