<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_meet_bj"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="654mm">
        <net.babycat.live.platform.widget.view.RoundImageView
            android:id="@+id/imgs_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/logo_blak"
            android:scaleType="centerCrop"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40mm"
        android:layout_marginStart="40mm"
        android:layout_marginEnd="40mm">
        <TextView
            android:textSize="20dp"
            android:textColor="#ff333333"
            android:ellipsize="end"
            android:id="@+id/tv_meet_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="昵称昵称昵称昵称…"
            android:maxLength="8"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20mm"
        android:layout_marginStart="40mm"
        android:layout_marginEnd="40mm">
        <ImageView
            android:id="@+id/iv_vip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/vip_1"
            android:layout_marginEnd="12mm"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lin_sex"
            android:background="@drawable/bg_nv_bj"
            android:layout_width="79mm"
            android:layout_height="32mm"
            android:layout_marginEnd="12mm">
            <ImageView
                android:id="@+id/image_sex"
                android:layout_width="18mm"
                android:layout_height="18mm"
                android:layout_marginTop="6mm"
                android:layout_marginBottom="6mm"
                android:src="@mipmap/image_nv"
                android:layout_marginStart="20mm"
                android:layout_marginEnd="4mm"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="20mm"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/level_0"
            android:layout_marginEnd="12mm"/>
        <ImageView
            android:id="@+id/iv_level_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/level_author_0"
            android:layout_marginEnd="12mm"/>
        <ImageView
            android:visibility="gone"
            android:layout_width="32mm"
            android:layout_height="32mm"
            android:src="@mipmap/image_jz"
            android:layout_marginEnd="12mm"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/re_agree"
        android:background="@drawable/bg_hy_add"
        android:layout_width="match_parent"
        android:layout_height="88mm"
        android:layout_marginTop="60mm"
        android:layout_marginBottom="40mm"
        android:layout_marginStart="40mm"
        android:layout_marginEnd="40mm">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agree_with"
            android:drawablePadding="8mm"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:drawableStart="@mipmap/family_sure"
            android:fontFamily="sans-serif-medium"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/re_refuse"
        android:background="@drawable/bg_family_refuse"
        android:layout_width="match_parent"
        android:layout_height="88mm"
        android:layout_marginBottom="40mm"
        android:layout_marginStart="40mm"
        android:layout_marginEnd="40mm">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/refuse_with"
            android:drawablePadding="8mm"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:drawableStart="@mipmap/family_result"
            android:fontFamily="sans-serif-medium"/>
    </RelativeLayout>
</LinearLayout>
