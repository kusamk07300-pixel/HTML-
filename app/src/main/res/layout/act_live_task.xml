<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#efefef"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_bj"
        android:background="@mipmap/iv_live_duration_bj"
        android:layout_width="match_parent"
        android:layout_height="444mm"/>
    <include
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/login_spacing"
        layout="@layout/common_toolbar"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_title"
        android:background="@drawable/bg_4d000000_r8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65mm"
        android:layout_below="@+id/top_bar"
        android:paddingStart="10mm"
        android:paddingEnd="10mm"
        android:layout_marginStart="30mm"
        android:layout_marginEnd="30mm"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="19mm"
        android:layout_below="@+id/tv_title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/re_list"
            android:background="@mipmap/iv_task_list_bj"
            android:paddingTop="52mm"
            android:paddingBottom="52mm"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="20mm"
            android:layout_weight="1"
            android:paddingStart="32mm"
            android:paddingEnd="32mm"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffef1f67"
            android:id="@+id/tv_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="*The reward can only be claimed once a day"
            android:layout_marginStart="28mm"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_receive"
            android:background="@mipmap/iv_task_red"
            android:layout_width="match_parent"
            android:layout_height="96mm"
            android:layout_marginTop="40mm"
            android:layout_marginBottom="40mm"
            android:text="@string/claim_reward"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm"/>
    </LinearLayout>
</RelativeLayout>
