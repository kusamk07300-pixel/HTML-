<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@mipmap/live_bj"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.babycat.live.modules.voice.view.LiveMicListLayoutView
        android:id="@+id/live_mic"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <net.babycat.live.modules.voice.view.LivePkLayoutView
        android:id="@+id/live_pk"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="300mm"/>
    <net.babycat.live.modules.voice.view.LiveAudienceRecyclerView
        android:id="@+id/recyclerView"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/re_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/iv_loading"
            android:background="@drawable/loading_animation"
            android:layout_width="50dp"
            android:layout_height="10dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
