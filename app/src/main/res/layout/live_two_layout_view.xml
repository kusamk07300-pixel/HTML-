<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="40mm">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="300mm"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:id="@+id/re_left"
            android:layout_width="192mm"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="192mm"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <net.babycat.live.platform.widget.view.WaveViews
                    android:id="@+id/image_speak"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:init_radius="50mm"
                    app:wave_color="@color/white"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/image_avatar"
                    android:layout_width="120mm"
                    android:layout_height="120mm"
                    android:src="@mipmap/live_empty"/>
                <ImageView
                    android:id="@+id/svga_view"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"/>
                <com.yy.yyeva.view.EvaAnimViewV3
                    android:id="@+id/eva_header"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/image_gif"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/image_wheat"
                    android:visibility="invisible"
                    android:layout_width="28mm"
                    android:layout_height="28mm"
                    android:layout_marginBottom="40mm"
                    android:src="@mipmap/live_wheat"
                    android:layout_marginEnd="40mm"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/lin_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/tv_obtain"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/iv_identity"
                    android:visibility="gone"
                    android:layout_width="25mm"
                    android:layout_height="25mm"
                    android:layout_marginEnd="5mm"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffffffff"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_obtain"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:drawablePadding="5mm"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:drawableStart="@mipmap/image_income"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/re_right"
            android:layout_width="192mm"
            android:layout_height="match_parent"
            android:layout_marginStart="72mm">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="192mm"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <net.babycat.live.platform.widget.view.WaveViews
                    android:id="@+id/image_speak_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:init_radius="50mm"
                    app:wave_color="@color/white"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/image_avatar_right"
                    android:layout_width="120mm"
                    android:layout_height="120mm"
                    android:src="@mipmap/live_empty"/>
                <ImageView
                    android:id="@+id/svga_view_right"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"/>
                <com.yy.yyeva.view.EvaAnimViewV3
                    android:id="@+id/eva_header_right"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/image_wheat_right"
                    android:visibility="invisible"
                    android:layout_width="28mm"
                    android:layout_height="28mm"
                    android:layout_marginBottom="40mm"
                    android:src="@mipmap/live_wheat"
                    android:layout_marginEnd="40mm"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/image_gif_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/tv_obtain_right"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/iv_identity_right"
                    android:visibility="gone"
                    android:layout_width="25mm"
                    android:layout_height="25mm"
                    android:layout_marginEnd="5mm"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffffffff"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_nickname_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_obtain_right"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:drawablePadding="5mm"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:drawableStart="@mipmap/image_income"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
