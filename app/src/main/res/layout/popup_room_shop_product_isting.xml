<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_shop_product_list_bj"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20mm"
        android:layout_marginStart="28mm"
        android:layout_marginEnd="28mm">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_shop_white"
            android:layout_width="0dp"
            android:layout_height="72mm"
            android:layout_weight="1">
            <ImageView
                android:layout_width="32mm"
                android:layout_height="32mm"
                android:src="@mipmap/shop_search"
                android:layout_marginStart="29mm"/>
            <EditText
                android:textSize="13dp"
                android:textColor="#333"
                android:id="@+id/ed_search"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/please_enter_content"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:layout_marginStart="13mm"
                android:layout_marginEnd="19mm"/>
        </LinearLayout>
    </LinearLayout>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/normal_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        app:srlDisableContentWhenLoading="true"
        app:srlDisableContentWhenRefresh="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/goods_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20mm"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</LinearLayout>
