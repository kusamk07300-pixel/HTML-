<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/re_desc"
    android:background="@mipmap/iv_room_desc"
    android:layout_width="match_parent"
    android:layout_height="986mm">
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="32mm"
        android:layout_height="32mm"
        android:layout_marginTop="126mm"
        android:src="@mipmap/iv_desc_close"
        android:layout_marginEnd="20mm"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="138mm"
        android:text=""
        android:layout_centerHorizontal="true"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="32mm"
        android:layout_below="@+id/tv_title">
        <TextView
            android:textSize="13dp"
            android:textColor="#ffffffff"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24mm"/>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
