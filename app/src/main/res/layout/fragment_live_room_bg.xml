<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.babycat.live.platform.widget.view.NestedScrollableHost
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_roombg_list"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="800mm"/>
    </net.babycat.live.platform.widget.view.NestedScrollableHost>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_save"
        android:background="@drawable/bg_login"
        android:layout_width="match_parent"
        android:layout_height="88mm"
        android:layout_marginLeft="40mm"
        android:layout_marginRight="40mm"
        android:layout_marginBottom="32mm"
        android:text="@string/btn_save"/>
</LinearLayout>
