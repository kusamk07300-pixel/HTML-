<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/country_item"
    android:layout_width="match_parent"
    android:layout_height="80mm">
    <ImageView
        android:id="@+id/image_gj"
        android:layout_width="62mm"
        android:layout_height="42mm"
        android:src="@drawable/flag_china"
        android:scaleType="fitXY"
        android:layout_marginStart="20mm"/>
    <ImageView
        android:id="@+id/iv_fire"
        android:visibility="gone"
        android:layout_width="30mm"
        android:layout_height="30mm"
        android:src="@mipmap/fire_ic"
        android:layout_marginStart="20mm"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/base_text_color"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="18mm"
        android:layout_marginEnd="10mm"/>
</LinearLayout>
