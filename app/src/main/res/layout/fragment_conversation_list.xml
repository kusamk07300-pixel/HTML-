<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_notice"
        android:paddingLeft="28mm"
        android:paddingRight="28mm"
        android:layout_width="match_parent"
        android:layout_height="136mm">
        <ImageView
            android:layout_width="80mm"
            android:layout_height="80mm"
            android:src="@mipmap/notice"
            android:layout_marginEnd="28mm"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/base_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/System_notifications"
                android:layout_centerVertical="true"/>
            <com.tencent.qcloud.tuikit.timcommon.component.UnreadCountTextView
                android:textSize="10sp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/conversation_unread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/tui_conversation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
