<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/box_rules_bj"
    android:layout_width="match_parent"
    android:layout_height="1000mm" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="64mm"
        android:layout_height="64mm"
        android:src="@mipmap/box_gb"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="180mm"
        android:layout_centerHorizontal="true">
        <View
            android:background="@mipmap/box_ornament_1"
            android:layout_width="118mm"
            android:layout_height="12mm"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#ffb7ffc7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history"
            android:layout_marginStart="12mm"
            android:layout_marginEnd="12mm"/>
        <View
            android:background="@mipmap/box_ornament_2"
            android:layout_width="118mm"
            android:layout_height="12mm"/>
    </LinearLayout>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/normal_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20mm"
        android:layout_marginBottom="90mm"
        android:layout_below="@+id/tv_title"
        android:overScrollMode="never"
        app:srlDisableContentWhenLoading="true"
        app:srlDisableContentWhenRefresh="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="34mm"
            android:layout_marginEnd="34mm"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</RelativeLayout>
