<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="136mm">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="135mm">
        <ImageView
            android:id="@+id/image_avatar"
            android:layout_width="96mm"
            android:layout_height="96mm"
            android:src="@mipmap/image_user"
            android:layout_marginStart="28mm"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="20mm">
            <TextView
                android:textSize="14dp"
                android:textColor="#ff333333"
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24mm"
                android:text="用户昵称"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16mm">
                <ImageView
                    android:id="@+id/image_vip"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/vip_1"
                    android:layout_marginEnd="12mm"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lin_nv"
                    android:background="@drawable/bg_nv_bj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12mm">
                    <ImageView
                        android:id="@+id/image_sex"
                        android:layout_width="20mm"
                        android:layout_height="20mm"
                        android:layout_marginTop="6mm"
                        android:layout_marginBottom="6mm"
                        android:src="@mipmap/image_nv"
                        android:layout_marginStart="12mm"
                        android:layout_marginEnd="8mm"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="12mm"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/iv_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/level_0"
                    android:layout_marginEnd="12mm"/>
                <ImageView
                    android:id="@+id/iv_level_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/level_author_0"
                    android:layout_marginEnd="12mm"/>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="28mm">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/second_text_color"
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="#f3f3f3"
        android:layout_width="match_parent"
        android:layout_height="1mm"
        android:layout_marginStart="144mm"
        android:layout_marginEnd="28mm"/>
</LinearLayout>
