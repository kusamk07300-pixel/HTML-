<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="28mm"
    android:paddingRight="28mm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="40mm">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/second_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20mm">
        <ImageView
            android:layout_width="88mm"
            android:layout_height="88mm"
            android:src="@mipmap/iocn_notice"
            android:layout_marginEnd="28mm"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_chat"
            android:background="@drawable/bg_f6f7f9_r12"
            android:paddingLeft="20mm"
            android:paddingTop="28mm"
            android:paddingRight="20mm"
            android:paddingBottom="28mm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/base_text_color"
                android:id="@+id/tv_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/official_notification"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/base_text_color"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
