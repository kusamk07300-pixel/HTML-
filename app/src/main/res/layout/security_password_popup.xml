<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_follow_add"
    android:layout_width="670mm"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40mm">
        <TextView
            android:textSize="16dp"
            android:textColor="#ff333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enter_your_security_password"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"/>
    </RelativeLayout>
    <net.babycat.live.platform.widget.view.CodeInputView
        android:textSize="14dp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/code_input"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxLength="6"
        android:inputType="numberPassword"
        app:borderHeight="36dp"
        app:borderSpacing="10dp"
        app:borderWidth="36dp"
        app:type="1"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#333"
        android:gravity="center"
        android:id="@+id/but_tj"
        android:background="@drawable/bg_pay_but_bj"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="@string/confirm"
        android:layout_marginStart="37dp"
        android:layout_marginEnd="37dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff333333"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_pass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/set_password"/>
</LinearLayout>
