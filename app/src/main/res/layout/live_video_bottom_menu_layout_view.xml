<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="64mm">
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="#bbbbbb"
        android:gravity="center_vertical"
        android:id="@+id/image_chat"
        android:background="@drawable/live_bottom_chat_bj"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/chat"
        android:layout_weight="1"
        android:paddingStart="12mm"
        android:layout_marginStart="28mm"
        android:layout_marginEnd="24mm"/>
    <ImageView
        android:id="@+id/image_chat_ic"
        android:visibility="gone"
        android:layout_width="64mm"
        android:layout_height="64mm"
        android:src="@mipmap/image_chat_live"
        android:layout_marginStart="28mm"
        android:layout_marginEnd="10mm"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="28mm">
        <ImageView
            android:id="@+id/image_xm"
            android:visibility="gone"
            android:layout_width="64mm"
            android:layout_height="64mm"
            android:src="@mipmap/iv_xiamai"
            android:layout_marginStart="20mm"/>
        <ImageView
            android:id="@+id/image_video"
            android:visibility="gone"
            android:layout_width="64mm"
            android:layout_height="64mm"
            android:src="@mipmap/iv_camera"
            android:layout_marginStart="20mm"/>
        <ImageView
            android:id="@+id/image_mute"
            android:layout_width="64mm"
            android:layout_height="64mm"
            android:src="@mipmap/image_mute_live"
            android:layout_marginStart="20mm"/>
        <FrameLayout
            android:id="@+id/frame_news"
            android:visibility="visible"
            android:layout_width="64mm"
            android:layout_height="match_parent"
            android:layout_marginStart="20mm">
            <ImageView
                android:id="@+id/image_news_anchor"
                android:layout_width="64mm"
                android:layout_height="64mm"
                android:src="@mipmap/image_chat_live"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/image_hd"
                android:visibility="gone"
                android:layout_width="16mm"
                android:layout_height="16mm"
                android:src="@mipmap/image_hd"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/image_gift"
            android:layout_width="64mm"
            android:layout_height="64mm"
            android:src="@mipmap/gift_iv"
            android:layout_centerVertical="true"
            android:layout_marginStart="20mm"/>
        <ImageView
            android:id="@+id/image_shopping"
            android:visibility="gone"
            android:layout_width="64mm"
            android:layout_height="64mm"
            android:src="@mipmap/room_shopping"
            android:layout_marginStart="20mm"/>
        <ImageView
            android:id="@+id/image_more"
            android:layout_width="64mm"
            android:layout_height="64mm"
            android:src="@mipmap/live_more_live"
            android:layout_marginStart="20mm"/>
        <ImageView
            android:id="@+id/image_wheat"
            android:visibility="visible"
            android:layout_width="64mm"
            android:layout_height="64mm"
            android:src="@mipmap/live_open_wheat_live"
            android:layout_marginStart="20mm"/>
    </LinearLayout>
</LinearLayout>
