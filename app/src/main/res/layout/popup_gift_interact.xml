<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_chat_new"
    android:layout_width="match_parent"
    android:layout_height="740mm">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="92mm"
        android:paddingStart="30mm"
        android:paddingEnd="30mm">
        <TextView
            android:textSize="40mm"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gift_menu"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="40mm"
            android:layout_height="40mm"
            android:src="@mipmap/close_white"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="40mm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28mm"
        android:paddingEnd="28mm">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_gift_interact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_start"
            android:background="@drawable/bg_gift_interact_start"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="96mm"
            android:layout_marginBottom="40mm"
            android:text="@string/start_gift_interact"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="56mm"
            android:layout_marginEnd="56mm"/>
    </RelativeLayout>
</LinearLayout>
