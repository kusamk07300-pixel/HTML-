<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@mipmap/iv_weekly_ran_bj"
    android:layout_width="match_parent"
    android:layout_height="136mm"
    android:layout_marginBottom="8mm">
    <TextView
        android:textSize="14dp"
        android:textColor="#654412"
        android:id="@+id/tv_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_marginStart="40mm"/>
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/item_avatar"
        android:layout_width="80mm"
        android:layout_height="80mm"
        android:src="@mipmap/circle_logo"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="20mm"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#654412"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="300mm"
        android:layout_height="wrap_content"
        android:text="xxx"
        android:maxLines="1"
        android:layout_marginStart="10mm"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14dp"
            android:textColor="#654412"
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10mm"
            android:text="0"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="40mm"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
