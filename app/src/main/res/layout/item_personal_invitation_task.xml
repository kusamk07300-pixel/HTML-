<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bottom_sheet_border"
    android:padding="20mm"
    android:layout_width="match_parent"
    android:layout_height="130mm"
    android:layout_marginBottom="40mm">
    <ImageView
        android:id="@+id/iv_task_status"
        android:layout_width="32mm"
        android:layout_height="32mm"
        android:src="@mipmap/iv_invitation_no"
        android:layout_marginEnd="8mm"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#685719"
        android:id="@+id/tv_task_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_weight="1"
        android:lineSpacingExtra="4dp"/>
    <ImageView
        android:layout_width="32mm"
        android:layout_height="32mm"
        android:src="@mipmap/jin"
        android:layout_marginStart="16mm"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#f7a43c"
        android:id="@+id/tv_task_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+200"
        android:layout_marginStart="8mm"/>
</LinearLayout>
