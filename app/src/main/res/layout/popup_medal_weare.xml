<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:paddingTop="20mm"
    android:paddingBottom="20mm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="28mm"
    android:paddingEnd="28mm">
    <ImageView
        android:id="@+id/iv_status"
        android:layout_width="32mm"
        android:layout_height="32mm"
        android:src="@mipmap/pay_type_normal"/>
    <ImageView
        android:id="@+id/iv_medal"
        android:layout_width="120mm"
        android:layout_height="120mm"
        android:layout_marginStart="28mm"
        android:layout_marginEnd="28mm"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/base_text_color"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="勋章名称"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/second_text_color"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm"
            android:text="@string/obtaining_time"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
