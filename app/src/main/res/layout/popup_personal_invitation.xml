<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/iv_personal_invitation_bj"
    android:paddingBottom="80mm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20mm"
    android:paddingEnd="20mm">
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="112mm"
        android:layout_height="112mm"
        android:layout_marginTop="80mm"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/lin_invitee_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10mm"
        android:layout_below="@+id/iv_avatar"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="16dp"
            android:textColor="#333333"
            android:ellipsize="end"
            android:id="@+id/tv_invitee_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:ellipsize="end"
            android:id="@+id/tv_invitee_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_task_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10mm"
        android:layout_below="@+id/lin_invitee_info"
        android:nestedScrollingEnabled="false"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#692b00"
        android:gravity="center"
        android:id="@+id/tv_close"
        android:background="@mipmap/iv_lnvite_but"
        android:visibility="visible"
        android:layout_width="208mm"
        android:layout_height="80mm"
        android:layout_marginTop="40mm"
        android:text="@string/titlebar_close"
        android:layout_below="@+id/recycler_task_list"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="129mm"
        android:layout_marginEnd="129mm"/>
</RelativeLayout>
