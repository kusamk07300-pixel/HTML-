<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#fafafc"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/common_toolbar"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/normal_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="20mm"
        android:layout_above="@+id/re_add"
        android:layout_below="@+id/top_bar"
        android:overScrollMode="never"
        app:srlDisableContentWhenLoading="true"
        app:srlDisableContentWhenRefresh="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20mm"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <RelativeLayout
        android:id="@+id/re_add"
        android:background="#fff"
        android:layout_width="match_parent"
        android:layout_height="136mm"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/lin_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="28mm">
            <ImageView
                android:id="@+id/iv_select"
                android:layout_width="28mm"
                android:layout_height="28mm"
                android:src="@mipmap/shop_address_2"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ff333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_all"
                android:layout_marginStart="8mm"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lin_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20mm"
            android:layout_toStartOf="@+id/tv_checkout">
            <TextView
                android:textSize="12dp"
                android:textColor="#ff333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_cart"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#fff92a3c"
                android:id="@+id/tv_total_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥0"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_checkout"
            android:background="@drawable/bg_shopping_butt_bj"
            android:layout_width="222mm"
            android:layout_height="96mm"
            android:text="@string/checkout"
            android:layout_centerVertical="true"
            android:layout_marginEnd="28mm"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
