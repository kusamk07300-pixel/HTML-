<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="161mm">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="160mm"
        android:paddingStart="32mm"
        android:paddingEnd="28mm">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="96mm"
            android:layout_height="96mm"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="32mm">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20mm">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/base_text_color"
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="20mm"/>
                <ImageView
                    android:id="@+id/iv_vip"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/vip_1"
                    android:layout_marginEnd="12mm"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lin_sex"
                    android:background="@drawable/bg_nv_bj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12mm">
                    <ImageView
                        android:id="@+id/image_sex"
                        android:layout_width="20mm"
                        android:layout_height="20mm"
                        android:layout_marginTop="6mm"
                        android:layout_marginBottom="6mm"
                        android:src="@mipmap/image_nv"
                        android:layout_marginStart="12mm"
                        android:layout_marginEnd="8mm"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="12mm"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/base_text_color"
                android:id="@+id/tv_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID："/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/bg_join_family_look"
            android:layout_width="88mm"
            android:layout_height="48mm"
            android:text="@string/view"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <View
        android:background="#f3f3f3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="160mm"
        android:layout_marginEnd="28mm"/>
</LinearLayout>
