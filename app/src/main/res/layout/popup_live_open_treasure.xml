<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_chat_new"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/view_title"
        android:paddingBottom="10mm"
        android:layout_width="match_parent"
        android:layout_height="92mm"
        android:paddingStart="30mm"
        android:paddingEnd="30mm">
        <ImageView
            android:id="@+id/image_head"
            android:layout_width="60mm"
            android:layout_height="60mm"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffffff"
            android:id="@+id/tv_nick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name sent a Treasure Box"
            android:layout_centerVertical="true"
            android:layout_marginStart="28dp"
            android:layout_toEndOf="@+id/image_head"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/gif_Treasure"
            android:layout_width="320mm"
            android:layout_height="320mm"
            android:src="@mipmap/image_treasure"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lin_1"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="240mm">
            <TextView
                android:textSize="20dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:id="@+id/tv_diamonds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28mm"
                android:text="0"
                android:drawableLeft="@mipmap/image_jb"
                android:drawablePadding="12mm"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:id="@+id/tv_people"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28mm"
                android:text="0 people can collect Coins. Even the sender has a chance to collect!"
                android:layout_marginStart="28mm"
                android:layout_marginEnd="28mm"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40mm"
                android:text="@string/red_envelope_open"
                android:layout_marginStart="28mm"
                android:layout_marginEnd="28mm"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lin_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="240mm">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28mm"
                android:text="@string/red_envelope_empty"
                android:layout_marginStart="28mm"
                android:layout_marginEnd="28mm"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40mm"
                android:text="@string/red_envelope_coins"
                android:layout_marginStart="28mm"
                android:layout_marginEnd="28mm"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40mm"
                android:text="@string/time_coins"
                android:layout_marginStart="28mm"
                android:layout_marginEnd="28mm"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/lin_3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="240mm">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@+id/tv_coins_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Congratulations Collect Coins:0"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="28mm"
                android:layout_marginEnd="28mm"/>
        </RelativeLayout>
        <net.babycat.live.platform.util.TimeCountDownTextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_send"
            android:background="@drawable/bg_open_bj"
            android:layout_width="match_parent"
            android:layout_height="96mm"
            android:layout_marginTop="24mm"
            android:layout_marginBottom="28mm"
            android:text="00:00"
            android:layout_marginStart="56mm"
            android:layout_marginEnd="56mm"/>
    </LinearLayout>
</LinearLayout>
