<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="58mm">
    <TextView
        android:id="@+id/tv_day_decade"
        android:visibility="gone"
        android:text="0"
        style="@style/RushBuyCountDownTimerViewStyle"/>
    <TextView
        android:id="@+id/tv_day_unit"
        android:visibility="gone"
        android:text="0"
        style="@style/RushBuyCountDownTimerViewStyle"/>
    <TextView
        android:id="@+id/tv_hour_decade"
        android:text="0"
        style="@style/RocketCountdownTimerViewStyle"/>
    <TextView
        android:id="@+id/tv_hour_unit"
        android:text="0"
        style="@style/RocketCountdownTimerViewStyle"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=":"
        android:layout_marginStart="4mm"
        android:layout_marginEnd="4mm"/>
    <TextView
        android:id="@+id/tv_min_decade"
        android:text="0"
        style="@style/RocketCountdownTimerViewStyle"/>
    <TextView
        android:id="@+id/tv_min_unit"
        android:text="0"
        style="@style/RocketCountdownTimerViewStyle"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=":"
        android:layout_marginStart="4mm"
        android:layout_marginEnd="4mm"/>
    <TextView
        android:id="@+id/tv_sec_decade"
        android:text="0"
        style="@style/RocketCountdownTimerViewStyle"/>
    <TextView
        android:id="@+id/tv_sec_unit"
        android:text="0"
        style="@style/RocketCountdownTimerViewStyle"/>
</LinearLayout>
