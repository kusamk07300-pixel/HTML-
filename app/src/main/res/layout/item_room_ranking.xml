<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="151mm">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="150mm">
        <RelativeLayout
            android:id="@+id/rela_num"
            android:layout_width="64mm"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12mm">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:id="@+id/tv_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_centerInParent="true"/>
            <ImageView
                android:visibility="gone"
                android:layout_width="40mm"
                android:layout_height="40mm"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/app_avatar"
            android:layout_width="70mm"
            android:layout_height="70mm"
            android:layout_centerVertical="true"
            android:layout_marginStart="20mm"
            android:layout_marginEnd="10mm"
            android:layout_toEndOf="@+id/rela_num"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/lin_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35mm"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/app_avatar">
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/app_nickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="昵称"
                android:maxLines="1"
                android:layout_weight="0.5"/>
            <ImageView
                android:id="@+id/app_gender"
                android:layout_width="30mm"
                android:layout_height="30mm"
                android:layout_marginStart="10mm"/>
            <ImageView
                android:id="@+id/image_grade"
                android:layout_width="80mm"
                android:layout_height="32mm"
                android:layout_marginStart="11mm"/>
            <ImageView
                android:id="@+id/image_charm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8mm"/>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:layout_toEndOf="@+id/lin_app">
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_gift_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="30mm"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="@color/second_text_color"
        android:layout_width="match_parent"
        android:layout_height="1mm"
        android:layout_marginStart="30mm"
        android:layout_marginEnd="30mm"/>
</LinearLayout>
