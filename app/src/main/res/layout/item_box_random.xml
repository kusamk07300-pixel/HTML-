<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@mipmap/blind_bj"
    android:layout_width="160mm"
    android:layout_height="210mm"
    android:layout_marginStart="16mm">
    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="104mm"
        android:layout_height="104mm"
        android:layout_marginTop="28mm"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28mm"
        android:text="x 1 Day"/>
</LinearLayout>
