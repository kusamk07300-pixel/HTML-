<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="30mm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/frame_top"
        android:layout_width="195mm"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/lin_main"
            android:visibility="visible"
            android:layout_width="180mm"
            android:layout_height="180mm"
            android:layout_centerHorizontal="true">
            <net.babycat.live.platform.widget.view.WaveViews
                android:id="@+id/image_speak"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                app:init_radius="60mm"
                app:wave_color="@color/white"/>
            <RelativeLayout
                android:id="@+id/fra_top"
                android:layout_width="180mm"
                android:layout_height="180mm"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/image_avatar"
                    android:layout_width="120mm"
                    android:layout_height="120mm"
                    android:src="@mipmap/live_empty"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/svga_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
                <com.yy.yyeva.view.EvaAnimViewV3
                    android:id="@+id/eva_header"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/image_wheat"
                    android:visibility="invisible"
                    android:layout_width="30mm"
                    android:layout_height="30mm"
                    android:layout_marginBottom="30mm"
                    android:src="@mipmap/live_wheat"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="35mm"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/image_gif"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="165mm">
            <ImageView
                android:id="@+id/iv_identity"
                android:visibility="gone"
                android:layout_width="25mm"
                android:layout_height="25mm"
                android:layout_marginEnd="5mm"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_main_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffffff"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_obtain"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="200mm"
            android:layout_marginBottom="4mm"
            android:text="0"
            android:drawablePadding="5mm"
            android:layout_centerHorizontal="true"
            android:drawableStart="@mipmap/image_income"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fra_boss"
        android:visibility="gone"
        android:layout_width="192mm"
        android:layout_height="192mm"
        android:layout_marginEnd="71mm"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/image_boss"
            android:layout_width="120mm"
            android:layout_height="120mm"
            android:src="@mipmap/image_boss"/>
        <ImageView
            android:id="@+id/svga_boss"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"/>
        <com.yy.yyeva.view.EvaAnimViewV3
            android:id="@+id/eva_boss"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/voice_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchMode="columnWidth"
        android:numColumns="auto_fit"
        android:layout_below="@+id/frame_top"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4"/>
    <RelativeLayout
        android:id="@+id/lin_pk"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12mm"
        android:layout_below="@+id/voice_list">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="32mm">
                <ProgressBar
                    android:id="@+id/pro_pk"
                    android:background="#179efe"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/layer_list_progress_pk"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>
                <net.babycat.live.platform.widget.view.GifView
                    android:id="@+id/gif_view"
                    android:visibility="visible"
                    android:layout_width="34mm"
                    android:layout_height="match_parent"
                    android:layout_centerHorizontal="true"
                    app:progress_gif="@raw/new_pking"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@+id/tv_pk_left_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20mm"
                    android:text="0"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@+id/tv_pk_right_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="20mm"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:background="@mipmap/countdown_bj"
                android:layout_width="172mm"
                android:layout_height="40mm">
                <ImageView
                    android:id="@+id/image_pk"
                    android:visibility="gone"
                    android:layout_width="32mm"
                    android:layout_height="32mm"
                    android:src="@mipmap/pk_icon"
                    android:layout_marginStart="35mm"/>
                <net.babycat.live.platform.util.TimeCountDownTextView
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@+id/countdown"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:layout_marginStart="9mm"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tv_pk"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/start"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/image_pk_close"
            android:visibility="gone"
            android:layout_width="28mm"
            android:layout_height="28mm"
            android:layout_marginTop="40mm"
            android:src="@mipmap/close_white"
            android:layout_marginEnd="12mm"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/ima_pk"
        android:layout_width="200mm"
        android:layout_height="200mm"
        android:layout_marginTop="20mm"
        android:layout_marginStart="80mm"/>
    <ImageView
        android:id="@+id/ima_pk2"
        android:layout_width="200mm"
        android:layout_height="200mm"
        android:layout_marginTop="20mm"
        android:layout_marginEnd="80mm"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
