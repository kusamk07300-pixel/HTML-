<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/page_top"
        android:layout_above="@+id/but_cj">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <Button
        android:textSize="16dp"
        android:textColor="@color/base_text_color"
        android:id="@+id/but_cj"
        android:background="@drawable/bg_new_family_but"
        android:layout_width="match_parent"
        android:layout_height="88mm"
        android:layout_marginBottom="100mm"
        android:text="@string/creating_family"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="28mm"
        android:layout_marginEnd="28mm"/>
</RelativeLayout>
