<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/lin_bj"
    android:background="@mipmap/iv_home_gift"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/common_toolbar"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/normal_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="40mm"
        android:overScrollMode="never"
        app:srlDisableContentWhenLoading="true"
        app:srlDisableContentWhenRefresh="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_log_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16mm"
            android:layout_marginBottom="16mm"
            android:layout_marginStart="25mm"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</LinearLayout>
