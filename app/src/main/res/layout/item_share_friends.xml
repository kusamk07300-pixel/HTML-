<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="161mm">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="160mm">
        <ImageView
            android:id="@+id/image_avatar"
            android:layout_width="96mm"
            android:layout_height="96mm"
            android:src="@mipmap/image_user"
            android:layout_marginStart="32mm"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="32mm">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24mm"
                android:text="用户昵称"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:id="@+id/tv_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15mm"
                android:text="ID：0"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_radic"
            android:layout_width="32mm"
            android:layout_height="32mm"
            android:src="@mipmap/radio_nor"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm"/>
    </LinearLayout>
</LinearLayout>
