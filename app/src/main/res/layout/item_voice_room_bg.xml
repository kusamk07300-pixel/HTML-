<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="306mm"
    android:layout_marginLeft="17mm"
    android:layout_marginRight="17mm"
    android:layout_marginBottom="32mm">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:id="@+id/ll_select_room"
        android:background="@drawable/bg_roombg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/iv_select"
        android:visibility="gone"
        android:layout_width="32mm"
        android:layout_height="32mm"
        android:src="@mipmap/roombg_select"/>
</FrameLayout>
