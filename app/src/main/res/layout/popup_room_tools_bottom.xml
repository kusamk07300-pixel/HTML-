<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_chat_fff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18dp"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20mm"
        android:text="@string/more"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/re_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/black"
        android:id="@+id/tv_game"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20mm"
        android:text="@string/quick_game"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/re_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/black"
        android:id="@+id/tv_casual"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20mm"
        android:text="@string/casual_games"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/re_casual_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
