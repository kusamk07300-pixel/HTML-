<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/bg_white_r20"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:minHeight="120dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:elevation="2dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/image_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@mipmap/image_user"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:ellipsize="end"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <ImageView
                android:id="@+id/image_vip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/vip_1"
                android:layout_marginEnd="6dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/lin_sex"
                android:background="@drawable/bg_nv_bj"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginEnd="6dp">
                <ImageView
                    android:id="@+id/image_sex"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@mipmap/image_nv"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:id="@+id/tv_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/iv_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/level_0"
                android:layout_marginEnd="6dp"/>
            <ImageView
                android:id="@+id/iv_level_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/level_author_0"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="#999999"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ff6b6b"
            android:gravity="center"
            android:id="@+id/tv_refuse"
            android:background="@drawable/bg_friend_apply_refuse"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:text="@string/refuse_with"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_agree"
            android:background="@drawable/bg_friend_apply_agree"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:text="@string/agree_with"/>
    </LinearLayout>
</LinearLayout>
