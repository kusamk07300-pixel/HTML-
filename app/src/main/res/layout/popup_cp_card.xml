<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="400mm">
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/cp_card"/>
    <net.babycat.live.platform.widget.view.CircleImageView
        android:id="@+id/iv_normal"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@mipmap/voice_logo"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/cp_card"/>
    <ImageView
        android:id="@+id/cp_card"
        android:visibility="invisible"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerInParent="true"/>
</RelativeLayout>
