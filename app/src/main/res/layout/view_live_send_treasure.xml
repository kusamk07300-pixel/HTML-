<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/lin_bj"
    android:background="@mipmap/image_unselected"
    android:layout_width="match_parent"
    android:layout_height="128mm"
    android:layout_marginTop="28mm">
    <ImageView
        android:layout_width="80mm"
        android:layout_height="80mm"
        android:src="@mipmap/image_treasure"
        android:layout_marginStart="20mm"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20mm">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:id="@+id/tv_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity:16"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffffff"
            android:id="@+id/tv_wrap_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6mm"
            android:text="16 people can collect Coins."/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="30mm"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_width="32mm"
                android:layout_height="32mm"
                android:src="@mipmap/image_jb"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffffff"
                android:id="@+id/tv_diamonds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20"
                android:layout_marginStart="8mm"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
