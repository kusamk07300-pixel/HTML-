<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/re_top"
    android:background="#f9efff"
    android:layout_width="match_parent"
    android:layout_height="match_parent" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/iv_top"
        android:layout_width="match_parent"
        android:layout_height="610mm"
        android:src="@mipmap/iv_maz_exchangebj"
        android:scaleType="fitXY"/>
    <include
        android:id="@+id/view_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/page_top"
        layout="@layout/common_toolbar"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/lin_title"
        android:background="@drawable/bg_exch_item"
        android:layout_width="match_parent"
        android:layout_height="80mm"
        android:layout_below="@+id/view_top">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/base_text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/host_information"
            android:layout_weight="2"
            android:layout_marginStart="20mm"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/base_text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/coin_number"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/base_text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/coins"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/base_text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/time"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/normal_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/lin_title"
        android:overScrollMode="never"
        app:srlDisableContentWhenLoading="true"
        app:srlDisableContentWhenRefresh="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</RelativeLayout>
