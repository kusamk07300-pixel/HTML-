<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="215mm"
    android:layout_marginTop="20mm">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="120mm"
            android:layout_height="120mm"
            android:layout_marginTop="10mm">
            <ImageView
                android:id="@+id/image_gift"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/tv_gift_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4mm"
            android:text=""
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12mm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="30mm"
            android:layout_height="30mm"
            android:src="@mipmap/jin"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#fff"
            android:id="@+id/tv_needcoin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8mm"/>
    </LinearLayout>
    <TextView
        android:textSize="7dp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tv_label"
        android:background="@drawable/bg_gift_label_1"
        android:paddingTop="2mm"
        android:paddingBottom="2mm"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8mm"
        android:text=""
        android:paddingStart="6mm"
        android:paddingEnd="6mm"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/image_gift_bj"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
