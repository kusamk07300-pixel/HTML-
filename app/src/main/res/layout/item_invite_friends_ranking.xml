<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_white_stroke_ffe99a_radius_17"
    android:layout_width="match_parent"
    android:layout_height="126mm"
    android:layout_marginBottom="20mm">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28mm">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/base_text_color"
            android:id="@+id/tv_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_head"
        android:layout_width="90mm"
        android:layout_height="90mm"
        android:layout_marginStart="20mm"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="28mm">
        <TextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:maxLines="1"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#af2e08"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_id"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5mm"
            android:text="Name"
            android:maxLines="1"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/lin_get"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="40mm">
            <TextView
                android:textSize="13dp"
                android:textColor="#af2e08"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#ff1212"
                android:id="@+id/tv_gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginStart="12mm"/>
            <ImageView
                android:visibility="gone"
                android:layout_width="30mm"
                android:layout_height="30mm"
                android:src="@mipmap/jin"
                android:layout_marginStart="12mm"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="40mm">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invitation"/>
            <TextView
                android:textSize="20dp"
                android:textColor="#ffe176"
                android:id="@+id/tv_cnt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginStart="15mm"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
