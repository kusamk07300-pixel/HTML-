<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#f9efff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@mipmap/bg_home_top"
        android:layout_width="match_parent"
        android:layout_height="305dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/lin_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/page_top">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/babycat"
            android:layout_marginStart="30mm"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1mm"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/rl_search"
            android:background="@drawable/bg_family_indicator"
            android:paddingLeft="14mm"
            android:paddingRight="14mm"
            android:layout_width="365mm"
            android:layout_height="54mm"
            android:layout_marginStart="20mm">
            <ImageView
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:src="@mipmap/home_search"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search"
                android:layout_marginStart="4mm"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/start_live"
            android:paddingLeft="25mm"
            android:paddingRight="25mm"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="13mm">
            <ImageView
                android:layout_width="54mm"
                android:layout_height="54mm"
                android:src="@mipmap/start_live"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tab_bar_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lin_top">
        <net.lucode.hackware.magicindicator.MagicIndicator
            android:id="@+id/home_magic_indicator"
            android:layout_width="0dp"
            android:layout_height="80mm"
            android:layout_weight="1"
            android:paddingStart="20mm"/>
    </LinearLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/home_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tab_bar_box"
        android:nestedScrollingEnabled="false"/>
    <net.babycat.live.platform.widget.view.DragImageView
        android:id="@+id/image_task"
        android:layout_width="130mm"
        android:layout_height="130mm"
        android:layout_marginBottom="120mm"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="15mm"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
