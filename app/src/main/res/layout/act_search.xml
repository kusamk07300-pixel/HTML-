<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="88mm"
            android:layout_marginTop="100mm">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/ll_left"
                android:layout_width="92mm"
                android:layout_height="88mm"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_width="44mm"
                    android:layout_height="44mm"
                    android:src="@mipmap/icon_back"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/bg_login_input_alpha"
                android:layout_width="match_parent"
                android:layout_height="68mm"
                android:layout_centerVertical="true"
                android:layout_marginEnd="28mm"
                android:layout_toEndOf="@+id/ll_left">
                <ImageView
                    android:layout_width="32mm"
                    android:layout_height="32mm"
                    android:src="@mipmap/ic_search"
                    android:layout_marginStart="26mm"/>
                <EditText
                    android:textSize="14dp"
                    android:textColor="@color/base_text_color"
                    android:textColorHint="#9395a4"
                    android:id="@+id/ed_search"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/search_id"
                    android:layout_weight="1"
                    android:textCursorDrawable="@drawable/my_cursor"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="viewStart"
                    android:layoutDirection="locale"
                    android:layout_marginStart="20mm"/>
                <View
                    android:background="#d1d1d1"
                    android:layout_width="2mm"
                    android:layout_height="match_parent"
                    android:layout_marginTop="14mm"
                    android:layout_marginBottom="14mm"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/base_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_search_type"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/user"
                    android:drawablePadding="16mm"
                    android:drawableEnd="@mipmap/search_drow"
                    android:paddingStart="24mm"
                    android:paddingEnd="24mm"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/search_history"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40mm"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#ff999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_history"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:layout_alignParentStart="true"/>
                <ImageView
                    android:id="@+id/image_dele"
                    android:layout_width="36mm"
                    android:layout_height="36mm"
                    android:src="@mipmap/search_delete"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40mm"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/search_data"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40mm"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#ff999999"
                    android:id="@+id/tv_search_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_result"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:layout_alignParentStart="true"/>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40mm"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/lin_family"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="160mm"
                android:layout_marginTop="40mm">
                <RelativeLayout
                    android:layout_width="142mm"
                    android:layout_height="142mm"
                    android:layout_marginStart="9mm">
                    <ImageView
                        android:id="@+id/image_family_avatar"
                        android:layout_width="92mm"
                        android:layout_height="92mm"
                        android:src="@mipmap/image_user"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:id="@+id/svga_family_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"/>
                    <com.yy.yyeva.view.EvaAnimViewV3
                        android:id="@+id/ev_family_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9mm">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="27mm">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#ff333333"
                            android:id="@+id/family_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="家族名称"/>
                        <FrameLayout
                            android:layout_width="40mm"
                            android:layout_height="40mm"
                            android:layout_marginStart="20mm">
                            <ImageView
                                android:id="@+id/image_family_badge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <com.yy.yyeva.view.EvaAnimViewV3
                                android:id="@+id/ev_family_badge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </FrameLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ff999999"
                        android:ellipsize="end"
                        android:id="@+id/tv_family_briefing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="21mm"
                        android:text="家族简介家族简介家族简介家族简介家族简介家族…"
                        android:maxLines="1"
                        android:layout_marginEnd="28mm"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <include
        android:id="@+id/in_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="400mm"
        layout="@layout/view_state_empty_search"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="13dp"
            android:textColor="#ff999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_describe"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="28mm"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_search_describe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm"
            android:layout_marginBottom="20mm"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20mm">
                <TextView
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="@color/base_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Step1: SELECT user/room/family "
                    android:layout_weight="1"
                    android:layout_marginStart="20mm"
                    android:layout_marginEnd="16mm"/>
                <ImageView
                    android:layout_width="160mm"
                    android:layout_height="160mm"
                    android:layout_margin="4mm"
                    android:src="@mipmap/iv_describe_noe"
                    android:layout_alignParentEnd="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20mm">
                <TextView
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="@color/base_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Step2: Fill in the real id number that you want to search for"
                    android:layout_weight="1"
                    android:layout_marginStart="20mm"
                    android:layout_marginEnd="16mm"/>
                <ImageView
                    android:layout_width="160mm"
                    android:layout_height="160mm"
                    android:layout_margin="4mm"
                    android:src="@mipmap/iv_describe_two"
                    android:layout_alignParentEnd="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
