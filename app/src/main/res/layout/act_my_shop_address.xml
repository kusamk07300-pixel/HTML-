<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#fafafc"
    android:layout_width="match_parent"
    android:layout_height="match_parent" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/common_toolbar"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/normal_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="20mm"
        android:layout_above="@+id/re_add"
        android:layout_below="@+id/top_bar"
        android:overScrollMode="never"
        app:srlDisableContentWhenLoading="true"
        app:srlDisableContentWhenRefresh="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20mm"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <RelativeLayout
        android:id="@+id/re_add"
        android:background="@drawable/bg_shopping_butt_bj"
        android:layout_width="match_parent"
        android:layout_height="96mm"
        android:layout_marginBottom="24mm"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="28mm"
        android:layout_marginEnd="28mm">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_new_address"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
