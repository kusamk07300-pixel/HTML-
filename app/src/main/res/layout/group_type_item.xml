<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/core_bg_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/page_margin">
    <RelativeLayout
        android:id="@+id/item_layout"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/contact_group_profile_height">
        <com.tencent.qcloud.tuikit.timcommon.component.gatherimage.ShadeImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/group_type_icon"
            android:layout_width="@dimen/contact_group_profile_face_size"
            android:layout_height="@dimen/contact_group_profile_face_size"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/contact_group_profile_face_margin_left"
            android:layout_marginEnd="@dimen/contact_group_profile_face_margin_right"/>
        <TextView
            android:textSize="@dimen/contact_group_profile_group_name_size"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/group_type_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/group_type_icon"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/contact_group_profile_group_id_size"
        android:gravity="center_vertical"
        android:id="@+id/group_type_content"
        android:background="#ffffff"
        android:paddingTop="@dimen/page_margin"
        android:paddingBottom="@dimen/page_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/item_layout"
        android:paddingStart="@dimen/contact_group_profile_face_margin_left"
        android:paddingEnd="@dimen/contact_group_profile_face_margin_right"/>
</RelativeLayout>
