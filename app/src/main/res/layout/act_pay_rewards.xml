<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@mipmap/iv_recharge_bj"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/page_top"
        layout="@layout/common_toolbar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@mipmap/bg_racharge_top"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#654412"
                android:gravity="center"
                android:id="@+id/tv_weekly"
                android:background="@mipmap/recharge_weekly_list"
                android:layout_width="200mm"
                android:layout_height="80mm"
                android:layout_marginTop="520mm"
                android:text="@string/weekly_list"
                android:fontFamily="sans-serif-medium"
                android:layout_alignParentEnd="true"/>
            <RelativeLayout
                android:id="@+id/re_down"
                android:background="@mipmap/iv_timer_bj"
                android:layout_width="match_parent"
                android:layout_height="176mm"
                android:layout_marginTop="-100mm"
                android:layout_below="@+id/iv_top"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="24mm"
                android:layout_marginEnd="24mm">
                <net.babycat.live.platform.widget.view.SnapUpCountDownTimerView
                    android:id="@+id/timer_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="73mm"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:paddingTop="40mm"
                android:paddingBottom="40mm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40mm"
                android:layout_below="@+id/lin_title"
                android:paddingStart="20mm"
                android:paddingEnd="20mm"
                android:layout_marginStart="20mm"
                android:layout_marginEnd="20mm">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_list"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/lin_title"
                android:background="@mipmap/reacharge_title"
                android:layout_width="match_parent"
                android:layout_height="220mm"
                android:layout_marginTop="-70mm"
                android:layout_below="@+id/re_down"
                android:layout_marginStart="20mm"
                android:layout_marginEnd="20mm">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#654412"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="88mm"
                    android:text="@string/current_amount"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8mm">
                    <ImageView
                        android:layout_width="40mm"
                        android:layout_height="40mm"
                        android:src="@mipmap/jin"/>
                    <TextView
                        android:textSize="24dp"
                        android:textStyle="bold"
                        android:textColor="#654412"
                        android:id="@+id/tv_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_marginStart="12mm"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="120mm">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#654412"
            android:gravity="center"
            android:id="@+id/tv_now"
            android:background="@mipmap/now_recharge"
            android:layout_width="600mm"
            android:layout_height="80mm"
            android:text="@string/recharge_now"/>
    </LinearLayout>
</LinearLayout>
