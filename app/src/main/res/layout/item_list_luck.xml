<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@mipmap/iv_luck_bj"
    android:layout_width="match_parent"
    android:layout_height="128mm"
    android:layout_marginTop="20mm"
    android:layout_marginStart="28mm">
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="19mm"
        android:layout_marginBottom="19mm"
        android:text="Name"
        android:layout_weight="1"
        android:lineSpacingExtra="4mm"
        android:layout_marginStart="20mm"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:background="@mipmap/iv_luck_ball"
        android:layout_width="96mm"
        android:layout_height="96mm"
        android:layout_marginStart="20mm"
        android:layout_marginEnd="20mm">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#fff9ff00"
            android:id="@+id/tv_lucky"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15mm"
            android:text="0"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="times"
            android:layout_below="@+id/tv_lucky"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</LinearLayout>
