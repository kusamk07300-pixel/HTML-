<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/bg_follow_add"
    android:paddingBottom="20mm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20mm">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20mm">
        <TextView
            android:textSize="14dp"
            android:textColor="#ff333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Official Store"
            android:layout_centerVertical="true"
            android:layout_marginStart="20mm"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ff333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/awaiting_payment"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20mm"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/item_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20mm"
        android:layout_marginEnd="20mm"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20mm"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="14dp"
                android:textColor="#ff333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/actual_payment"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#f92a3c"
                android:id="@+id/tv_total_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥0.00"
                android:layout_marginStart="10mm"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/tv_checkout"
        android:background="@drawable/bg_shopping_butt_bj"
        android:layout_width="200mm"
        android:layout_height="80mm"
        android:layout_marginTop="20mm"
        android:text="@string/checkout"
        android:layout_centerVertical="true"
        android:layout_marginEnd="20mm"
        android:layout_alignParentEnd="true"/>
</LinearLayout>
