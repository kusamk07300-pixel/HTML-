<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bj_chat_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="20mm"
    android:layout_marginStart="28mm">
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_char_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12mm"
        android:layout_marginBottom="12mm"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="12mm"
        android:layout_marginEnd="12mm"/>
</LinearLayout>
