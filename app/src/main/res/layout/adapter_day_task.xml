<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="136mm">
        <ImageView
            android:id="@+id/iv_imgs"
            android:layout_width="88mm"
            android:layout_height="88mm"
            android:layout_marginStart="28mm"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="20mm"
            android:layout_marginStart="20mm">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/base_text_color"
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8mm">
                <ImageView
                    android:visibility="gone"
                    android:layout_width="32mm"
                    android:layout_height="32mm"
                    android:src="@mipmap/huo_small"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/base_text_color"
                    android:id="@+id/tv_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_marginStart="12mm"
                    android:layout_marginEnd="12mm"/>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/base_text_color"
                android:id="@+id/tv_no_complete"
                android:background="@drawable/bg_task_no"
                android:paddingTop="11mm"
                android:paddingBottom="11mm"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/to_complete"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="24mm"
                android:paddingEnd="24mm"
                android:layout_marginEnd="28mm"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/base_text_color"
                android:id="@+id/tv_completed"
                android:background="@drawable/bg_task_ok"
                android:paddingTop="11mm"
                android:paddingBottom="11mm"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已完成"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="24mm"
                android:paddingEnd="24mm"
                android:layout_marginEnd="28mm"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="#f3f3f3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="136mm"
        android:layout_marginEnd="28mm"/>
</LinearLayout>
