<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/layout_root"
    android:background="@drawable/bg_gift_interact_select_item"
    android:padding="16mm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12mm">
    <ImageView
        android:id="@+id/iv_gift_icon"
        android:layout_width="80mm"
        android:layout_height="80mm"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="20mm">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:id="@+id/tv_gift_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8mm">
            <ImageView
                android:layout_width="20mm"
                android:layout_height="20mm"
                android:src="@mipmap/iv_yellow_diamond"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:id="@+id/tv_needcoin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4mm"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tv_send"
        android:background="@drawable/bg_gift_interact_send_btn"
        android:layout_width="wrap_content"
        android:layout_height="64mm"
        android:text="@string/send_gift"
        android:paddingStart="40mm"
        android:paddingEnd="40mm"
        android:layout_marginStart="20mm"/>
</LinearLayout>
