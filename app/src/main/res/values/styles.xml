<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="core_primary_color">@color/main_color</item>
        <item name="core_btn_disable_color">@color/grey_f6</item>
        <item name="core_btn_normal_color">@color/main_color</item>
        <item name="core_btn_pressed_color">@color/btn_positive_hover</item>
        <item name="core_header_end_color">@color/main_color</item>
        <item name="core_header_start_color">@color/main_color</item>
        <item name="chat_pressed_bg_color">#E0E0E0</item>
        <item name="chat_input_area_bg">#F5F5F5</item>
        <item name="chat_jump_recent_down_icon">@drawable/arrow_right</item>
        <item name="chat_react_text_color">@color/main_color</item>
        <item name="chat_reply_detail_icon">@drawable/arrow_right</item>
        <item name="chat_self_custom_msg_link_color">@color/main_color</item>
        <item name="chat_self_custom_msg_text_color">@color/white</item>
        <item name="chat_self_msg_text_color">@color/white</item>
        <item name="chat_self_reply_line_bg_color">@color/main_color</item>
        <item name="chat_self_reply_quote_bg_color">#E8F5E9</item>
        <item name="chat_self_reply_quote_text_color">@color/text_color_black</item>
        <item name="chat_self_reply_text_color">@color/text_color_black</item>
        <item name="chat_tip_text_color">@color/hint_color</item>
        <item name="conversation_tab_selected">@drawable/bg_shape_rect_theme</item>
        <item name="core_bg_color">@color/white</item>
        <item name="core_default_user_icon">@drawable/bg_tag_user</item>
        <item name="core_error_tip_color">@color/btn_negative</item>
        <item name="core_selected_icon">@drawable/bg_shape_oval_theme</item>
        <item name="core_title_bar_back_icon">@drawable/arrow_right</item>
        <item name="core_title_bar_text_bg">@drawable/bg_shape_white</item>
    </style>

    <style name="LaunchTheme" parent="@style/AppTheme"/>

    <style name="ActivityTranslucent" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="CoreActivityTranslucent" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ConversationTransparentPopActivityStyle" parent="@style/Theme.AppCompat.Light.NoActionBar"/>

    <style name="ContactTransparentPopActivityStyle" parent="@style/Theme.AppCompat.Light.NoActionBar"/>

    <style name="ChatTransparentPopActivityStyle" parent="@style/Theme.AppCompat.Light.NoActionBar"/>

    <!-- Login styles -->
    <style name="login_input_parent_white_alpha">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">#B3FFFFFF</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="login_input_parent_grey">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">#F5F5F5</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="login_input_white">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="login_input_grey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#999999</item>
    </style>

    <style name="login_btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_btn_gradint_56</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="login_style_item">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#666666</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
