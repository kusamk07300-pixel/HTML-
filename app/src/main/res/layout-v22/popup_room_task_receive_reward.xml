<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="1200mm">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/rew_rule_bg"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="20mm"
        android:paddingRight="20mm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20mm">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="72mm"
            android:layoutDirection="ltr">
            <ImageView
                android:layout_width="436mm"
                android:layout_height="8mm"
                android:src="@mipmap/bg_tio_rew_top"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/receives"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40mm"
            android:text="@string/yesterday_gold_reward"/>
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_num"
            android:background="@mipmap/rew_room_receive_bj"
            android:layout_width="562mm"
            android:layout_height="160mm"
            android:layout_marginTop="20mm"
            android:text="0"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_receive"
            android:background="@mipmap/rew_rules_bj"
            android:visibility="gone"
            android:layout_width="320mm"
            android:layout_height="80mm"
            android:layout_marginTop="20mm"
            android:text="@string/receive"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40mm"
            android:text="@string/daily_update_time"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#3d0b41"
            android:layout_width="match_parent"
            android:layout_height="122mm"
            android:layout_marginTop="20mm">
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/level"
                android:layout_weight="0.5"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/host_reward"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/top10_reward"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/time"
                android:layout_weight="1"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rules_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="20mm"/>
    </LinearLayout>
</RelativeLayout>
