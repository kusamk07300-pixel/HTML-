                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:paddingStart="68mm"
                        android:paddingEnd="68mm">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/tv_recharge"
                            android:background="@mipmap/rech_btn"
                            android:layout_width="match_parent"
                            android:layout_height="88mm"
                            android:text="@string/recharge"
                            android:layout_centerVertical="true"
                            android:fontFamily="sans-serif-medium"
                            android:textFontWeight="600"/>
                    </RelativeLayout>
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="12mm"
                        android:src="@mipmap/reah_line"
                        android:layout_marginStart="48mm"
                        android:layout_marginEnd="48mm"/>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40mm"
                        android:layout_marginBottom="134mm">
