                                android:layout_width="302mm"
                                android:layout_height="562mm">
                                <ImageView
                                    android:id="@+id/iv_car_icon"
                                    android:layout_width="match_parent"
                                    android:layout_height="534mm"
                                    android:layout_alignParentBottom="true"/>
                                <LinearLayout
                                    android:gravity="center"
                                    android:id="@+id/ll_play_video"
