                                    <FrameLayout
                                        android:layout_width="128mm"
                                        android:layout_height="wrap_content">
                                        <ImageView
                                            android:layout_gravity="bottom"
                                            android:id="@+id/iv_frame"
                                            android:visibility="gone"
                                            android:layout_width="128mm"
                                            android:layout_height="128mm"/>
