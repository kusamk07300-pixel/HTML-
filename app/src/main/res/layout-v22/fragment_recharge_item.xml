                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12mm"
                                        android:text="礼物名称"/>
                                    <TextView
                                        android:textSize="13dp"
                                        android:textColor="@color/white"
                                        android:id="@+id/tv_vip_day"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="12mm"
                                        android:text="礼物名称"/>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical"
                                    android:id="@+id/ll_box"
                                    android:visibility="gone"
                                    android:layout_width="128mm"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="20mm">
                                    <FrameLayout
                                        android:layout_width="128mm"
                                        android:layout_height="wrap_content">
                                        <ImageView
                                            android:layout_gravity="bottom"
                                            android:id="@+id/iv_box"
                                            android:layout_width="128mm"
                                            android:layout_height="128mm"/>
                                        <ImageView
                                            android:layout_width="128mm"
                                            android:layout_height="144mm"
                                            android:src="@mipmap/small_reach"/>
                                    </FrameLayout>
                                    <TextView
                                        android:textSize="13dp"
                                        android:textColor="@color/white"
                                        android:id="@+id/tv_box_name"
                                        android:visibility="gone"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12mm"
                                        android:text="礼物名称"/>
