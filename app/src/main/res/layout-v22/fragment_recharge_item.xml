                                </LinearLayout>
                                <LinearLayout
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical"
                                    android:id="@+id/ll_vip"
                                    android:visibility="gone"
                                    android:layout_width="128mm"
                                    android:layout_height="wrap_content">
                                    <FrameLayout
                                        android:layout_width="128mm"
                                        android:layout_height="wrap_content">
