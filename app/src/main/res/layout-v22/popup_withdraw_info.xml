<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="65mm"
    android:layout_marginEnd="65mm">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_white_r22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24mm"
        android:paddingEnd="24mm">
        <TextView
            android:textSize="28mm"
            android:textColor="@color/base_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24mm"
            android:layout_marginBottom="20mm"
            android:text="@string/withdrawal_methods"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#333"
            android:textColorHint="#333"
            android:gravity="center_vertical"
            android:background="@drawable/bg_wuthdraw"
            android:layout_width="match_parent"
            android:layout_height="100mm"
            android:text="@string/self_recharge"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="28mm"
            android:paddingEnd="28mm"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="28mm"
            android:textColor="@color/base_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24mm"
            android:layout_marginBottom="20mm"
            android:text="@string/recharge_id"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#333"
            android:gravity="center_vertical"
            android:id="@+id/tv_recharge_id"
            android:background="@drawable/bg_wuthdraw"
            android:layout_width="match_parent"
            android:layout_height="100mm"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="28mm"
            android:paddingEnd="28mm"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="28mm"
            android:textColor="@color/base_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24mm"
            android:layout_marginBottom="20mm"
            android:text="@string/real_name"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#333"
            android:gravity="center_vertical"
            android:id="@+id/tv_recharge_name"
            android:background="@drawable/bg_wuthdraw"
            android:layout_width="match_parent"
            android:layout_height="100mm"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="28mm"
            android:paddingEnd="28mm"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="28mm"
            android:textColor="@color/base_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24mm"
            android:layout_marginBottom="20mm"
            android:text="@string/withdrawal_amount"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <LinearLayout
            android:background="@drawable/bg_wuthdraw"
            android:layout_width="match_parent"
            android:layout_height="100mm">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="36mm"
                android:layout_height="36mm"
                android:src="@mipmap/jin"
                android:layout_marginStart="28mm"/>&gt; 
            <TextView
                android:textSize="14sp"
                android:textColor="#333"
                android:gravity="center_vertical"
                android:id="@+id/tv_amount"
                android:background="@drawable/bg_wuthdraw"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="28mm"
                android:textFontWeight="600"/>
        </LinearLayout>
        <TextView
            android:textSize="28mm"
            android:textColor="@color/base_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24mm"
            android:layout_marginBottom="20mm"
            android:text="@string/amount_expected"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:background="@drawable/bg_wuthdraw"
            android:layout_width="match_parent"
            android:layout_height="100mm">
            <ImageView
                android:layout_width="36mm"
                android:layout_height="36mm"
                android:src="@mipmap/icon_diamond"
                android:layout_marginStart="28mm"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:textColorHint="#333"
                android:gravity="center_vertical"
                android:id="@+id/tv_coins"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="28mm"
                android:textFontWeight="600"/>
        </LinearLayout>
        <Button
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/btn_confirm"
            android:background="@drawable/bg_login"
            android:layout_width="match_parent"
            android:layout_height="88mm"
            android:layout_marginTop="40mm"
            android:layout_marginBottom="40mm"
            android:text="@string/define"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="14mm"
            android:layout_marginEnd="14mm"
            android:textFontWeight="600"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_end"
        android:layout_width="48mm"
        android:layout_height="48mm"
        android:layout_marginTop="48mm"
        android:src="@mipmap/popup_end"/>
</LinearLayout>
