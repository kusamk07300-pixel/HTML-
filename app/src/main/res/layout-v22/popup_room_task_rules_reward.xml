<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lin_web"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="1200mm">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/rew_rule_bg"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="20mm"
        android:paddingRight="20mm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20mm">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="72mm"
            android:layoutDirection="ltr">
            <ImageView
                android:layout_width="436mm"
                android:layout_height="8mm"
                android:src="@mipmap/bg_tio_rew_top"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ruless"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="40mm">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="28mm"
                android:layout_marginEnd="28mm">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_1"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20mm"
                    android:text="@string/rule_2"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12mm"
                    android:text="@string/rule_3"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12mm"
                    android:text="@string/rule_4"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20mm"
                    android:text="@string/rule_5"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12mm"
                    android:text="@string/rule_6"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12mm"
                    android:text="@string/rule_7"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20mm"
                    android:text="@string/rule_8"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffefbc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20mm"
                    android:text="@string/rule_9"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffefbc"
                    android:id="@+id/tv_min_limit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20mm"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="#3d0b41"
                    android:layout_width="match_parent"
                    android:layout_height="122mm"
                    android:layout_marginTop="20mm">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/level"
                        android:layout_weight="0.5"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/room_revenue"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/host_reward"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/reward_split"
                        android:layout_weight="1.5"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rules_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="20mm"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</RelativeLayout>
