<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/lin_item"
    android:layout_width="match_parent"
    android:layout_height="160mm"
    android:paddingStart="32mm"
    android:paddingEnd="32mm">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/image_avatar"
            android:layout_width="96mm"
            android:layout_height="96mm"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="96mm"
            android:layout_weight="1"
            android:layout_marginStart="32mm">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ff333333"
                    android:ellipsize="end"
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="180mm"
                    android:text="昵称"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"/>
                <ImageView
                    android:id="@+id/image_vip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/vip_1"
                    android:layout_marginStart="12mm"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lin_nv"
                    android:background="@drawable/bg_nv_bj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12mm">
                    <ImageView
                        android:id="@+id/image_sex"
                        android:layout_width="20mm"
                        android:layout_height="20mm"
                        android:layout_marginTop="6mm"
                        android:layout_marginBottom="6mm"
                        android:src="@mipmap/image_nv"
                        android:layout_marginStart="12mm"
                        android:layout_marginEnd="8mm"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="12mm"
                        android:textFontWeight="600"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/iv_fans_level"
                    android:visibility="gone"
                    android:layout_width="96mm"
                    android:layout_height="40mm"
                    android:src="@mipmap/fans_1"
                    android:layout_marginStart="12mm"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/base_text_color"
                android:id="@+id/tv_uid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15mm"
                android:text="ID：0"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_manger"
                android:layout_width="48mm"
                android:layout_height="32mm"
                android:src="@mipmap/family_manger"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="#f3f3f3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="128mm"/>
</LinearLayout>
