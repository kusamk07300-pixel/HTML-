<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f6f7fb"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/my_wallet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/common_toolbar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24mm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_wallet">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_edittext"
                android:paddingTop="30mm"
                android:paddingBottom="30mm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24mm"
                android:paddingStart="20mm"
                android:paddingEnd="20mm"
                android:layout_marginStart="28mm"
                android:layout_marginEnd="28mm">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/base_text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/withdrawable_balance"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14mm">
                    <ImageView
                        android:layout_width="36mm"
                        android:layout_height="36mm"
                        android:src="@mipmap/icon_diamond"
                        android:layout_marginEnd="8mm"/>
                    <TextView
                        android:textSize="18dp"
                        android:textColor="#5bc655"
                        android:id="@+id/tv_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24mm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recharge_id"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="28mm"
                        android:textFontWeight="600"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="#333"
                        android:textColorHint="#333"
                        android:id="@+id/realName"
                        android:background="@drawable/bg_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="100mm"
                        android:layout_marginTop="24mm"
                        android:inputType="number"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="28mm"
                        android:paddingEnd="28mm"
                        android:layout_marginStart="28mm"
                        android:layout_marginEnd="28mm"
                        android:textFontWeight="600"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:id="@+id/lin_user"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20mm"
                        android:layout_marginStart="28mm">
                        <ImageView
                            android:id="@+id/iv_header"
                            android:layout_width="88mm"
                            android:layout_height="88mm"
                            android:src="@mipmap/image_user"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20mm">
                            <TextView
                                android:textSize="16sp"
                                android:textColor="#333"
                                android:id="@+id/tv_nickname"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="name"
                                android:fontFamily="sans-serif-medium"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#333"
                                android:id="@+id/tv_uid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0000000000"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24mm"
                    android:layout_marginBottom="46mm"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout2">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/phone_number"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="40mm"
                        android:textFontWeight="600"/>
                    <EditText
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/white"
                        android:background="@drawable/bg_edittext"
                        android:paddingLeft="20mm"
                        android:paddingRight="20mm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="40mm"
                        android:layout_marginTop="10mm"
                        android:layout_marginRight="40mm"
                        android:minWidth="320mm"
                        android:minHeight="60mm"
                        android:hint="01026705142"
                        android:layout_marginHorizontal="40mm"
                        android:paddingHorizontal="20mm"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24mm"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/withdrawal_amount"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="28mm"
                        android:textFontWeight="600"/>
                    <LinearLayout
                        android:background="@drawable/bg_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="100mm"
                        android:layout_marginTop="24mm"
                        android:layout_marginStart="28mm"
                        android:layout_marginEnd="28mm">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="36mm"
                            android:layout_height="36mm"
                            android:src="@mipmap/jin"
                            android:layout_marginStart="28mm"/>&gt; 
                        <EditText
                            android:textSize="14sp"
                            android:textColor="#333"
                            android:textColorHint="#333"
                            android:id="@+id/et_reward_num"
                            android:background="@drawable/bg_edittext"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:maxLength="7"
                            android:inputType="number"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="28mm"
                            android:textFontWeight="600"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24mm"
                    android:layout_marginBottom="46mm"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/phone_number"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="40mm"
                        android:textFontWeight="600"/>
                    <EditText
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/white"
                        android:background="@drawable/bg_edittext"
                        android:paddingLeft="20mm"
                        android:paddingRight="20mm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="40mm"
                        android:layout_marginTop="10mm"
                        android:layout_marginRight="40mm"
                        android:minWidth="320mm"
                        android:minHeight="60mm"
                        android:hint="01026705142"
                        android:layout_marginHorizontal="40mm"
                        android:paddingHorizontal="20mm"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ff5f66"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amount_expected"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="28mm"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ff5f66"
                    android:id="@+id/tv_expected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8mm"
                    android:layout_marginEnd="8mm"
                    android:textFontWeight="600"/>
                <ImageView
                    android:layout_width="24mm"
                    android:layout_height="24mm"
                    android:src="@mipmap/icon_diamond"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/paymentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40mm">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/sure"
                    android:background="@drawable/bg_login"
                    android:layout_width="match_parent"
                    android:layout_height="88mm"
                    android:layout_marginBottom="40mm"
                    android:layout_marginStart="40mm"
                    android:layout_marginEnd="40mm">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:text="@string/withdrawal"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginHorizontal="10dp"
                        android:textFontWeight="600"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
