<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="24mm"
        android:paddingBottom="24mm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="30mm">
        <LinearLayout
            android:gravity="center"
            android:layout_width="90mm"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_rank"
                android:visibility="gone"
                android:layout_width="48mm"
                android:layout_height="48mm"
                android:src="@mipmap/family_coin1"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/second_text_color"
                android:id="@+id/tv_rank"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="600"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="96mm"
            android:layout_height="96mm"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20mm">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/base_text_color"
                    android:ellipsize="end"
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="20mm"
                    android:textFontWeight="600"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/base_text_color"
                android:id="@+id/tv_id"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8mm"
                android:text="ID："/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16mm">
                <ImageView
                    android:id="@+id/image_vip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/vip_1"
                    android:layout_marginEnd="12mm"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lin_nv"
                    android:background="@drawable/bg_nv_bj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12mm">
                    <ImageView
                        android:id="@+id/image_sex"
                        android:layout_width="20mm"
                        android:layout_height="20mm"
                        android:layout_marginTop="6mm"
                        android:layout_marginBottom="6mm"
                        android:src="@mipmap/image_nv"
                        android:layout_marginStart="12mm"
                        android:layout_marginEnd="8mm"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="12mm"
                        android:textFontWeight="600"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/base_text_color"
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
    </LinearLayout>
    <View
        android:background="#f3f3f3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="90mm"
        android:layout_marginEnd="28mm"/>
</LinearLayout>
