<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/home_bj"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28mm"
        android:paddingEnd="28mm">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/base_text_color"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="37mm"
            android:text="@string/set_room_cover"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="200mm"
            android:layout_height="200mm"
            android:layout_marginTop="20mm">
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@mipmap/voice_logo"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input_alpha"
            android:layout_width="match_parent"
            android:layout_height="120mm"
            android:layout_marginTop="50mm">
            <EditText
                android:textSize="13dp"
                android:textColor="@color/base_text_color"
                android:textColorHint="#9395a4"
                android:id="@+id/et_room_name"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20mm"
                android:layout_marginRight="20mm"
                android:text=""
                android:hint="@string/enter_room_name"
                android:layout_marginHorizontal="20mm"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_theme"
            android:background="@drawable/bg_login_input_alpha"
            android:layout_width="match_parent"
            android:layout_height="120mm"
            android:layout_marginTop="20mm"
            android:paddingStart="28mm"
            android:paddingEnd="28mm">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_tag"
                android:background="@drawable/bg_base_r24"
                android:paddingLeft="7mm"
                android:paddingTop="4mm"
                android:paddingRight="7mm"
                android:paddingBottom="4mm"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginStart="20mm"
                android:paddingHorizontal="7mm"
                android:paddingVertical="4mm"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/base_text_color"
                android:ellipsize="end"
                android:id="@+id/tv_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20mm"
                android:layout_marginRight="20mm"
                android:text="@string/enter_room_announcement"
                android:maxLines="1"
                android:layout_marginHorizontal="20mm"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_save"
        android:background="@drawable/bg_login_google"
        android:layout_width="match_parent"
        android:layout_height="88mm"
        android:layout_marginLeft="120mm"
        android:layout_marginRight="120mm"
        android:text="@string/start_live"
        android:layout_above="@+id/v1"
        android:layout_marginHorizontal="120mm"/>
    <View
        android:id="@+id/v1"
        android:layout_width="match_parent"
        android:layout_height="100mm"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
