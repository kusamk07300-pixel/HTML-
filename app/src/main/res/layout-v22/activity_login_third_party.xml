<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/rel_top"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@mipmap/logoin_bg"
        android:layout_width="match_parent"
        android:layout_height="328mm"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="321mm">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="200mm"
                    android:layout_height="200mm"
                    android:src="@mipmap/voice_logo"/>
                <TextView
                    android:textSize="22dp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="47mm"
                    android:text="@string/get_start"
                    android:fontFamily="sans-serif-medium"
                    android:lineHeight="53mm"
                    android:textFontWeight="700"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7mm"
                    android:text="@string/sign_up_access"
                    android:lineHeight="17dp"/>
                <RelativeLayout
                    android:id="@+id/re_google"
                    android:background="@drawable/bg_login_google"
                    android:layout_width="match_parent"
                    android:layout_height="112mm"
                    android:layout_marginTop="160mm"
                    android:layout_marginStart="56mm"
                    android:layout_marginEnd="56mm">
                    <ImageView
                        android:layout_width="48mm"
                        android:layout_height="48mm"
                        android:src="@mipmap/image_google"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="160mm"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Google Login"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="700"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/re_facebook"
                    android:background="@drawable/bg_login_fac"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="112mm"
                    android:layout_marginTop="48mm"
                    android:layout_marginStart="56mm"
                    android:layout_marginEnd="56mm">
                    <ImageView
                        android:layout_width="48mm"
                        android:layout_height="48mm"
                        android:src="@mipmap/image_facebook"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="160mm"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facebook"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:paddingBottom="63mm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/second_text_color"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/other_login_methods"
                            android:lineHeight="29mm"/>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:id="@+id/ll_other_login"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="45mm"
                            android:layout_marginBottom="48mm">
                            <ImageView
                                android:id="@+id/iv_phone"
                                android:visibility="gone"
                                android:src="@mipmap/login_pjone"
                                style="@style/login_style_item"/>
                            <ImageView
                                android:id="@+id/iv_email"
                                android:visibility="gone"
                                android:src="@mipmap/login_email"
                                style="@style/login_style_item"/>
                            <ImageView
                                android:id="@+id/iv_id"
                                android:visibility="visible"
                                android:src="@mipmap/login_id"
                                style="@style/login_style_item"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:id="@+id/ll_user_agree"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">
                            <LinearLayout
                                android:gravity="center"
                                android:id="@+id/ll_agree"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/iv_agree"
                                    android:layout_width="28mm"
                                    android:layout_height="28mm"
                                    android:src="@mipmap/login_no_choose"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="@dimen/login_base_text"
                                android:textColor="@color/black"
                                android:id="@+id/tv_protocol"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/login_agrees"
                                android:layout_marginStart="10mm"/>
                            <TextView
                                android:textSize="@dimen/login_base_text"
                                android:textColor="@color/black"
                                android:id="@+id/tv_user"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/user_xy"/>
                            <TextView
                                android:textSize="@dimen/login_base_text"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/and"
                                android:layout_marginStart="10mm"
                                android:layout_marginEnd="10mm"/>
                            <TextView
                                android:textSize="@dimen/login_base_text"
                                android:textColor="@color/black"
                                android:id="@+id/tv_privacy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/user_xys"/>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/black"
        android:id="@+id/tv_language"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100mm"
        android:text="简体中文"
        android:drawablePadding="12mm"
        android:drawableStart="@mipmap/image_language"
        android:layout_marginStart="40mm"
        android:layout_marginEnd="15dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
