<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_meet_bj"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="654mm">
        <net.babycat.live.platform.widget.view.RoundImageView
            android:id="@+id/imgs_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/logo_blak"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/image_gd"
            android:layout_width="44mm"
            android:layout_height="44mm"
            android:layout_margin="24mm"
            android:src="@mipmap/icon_more_white"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40mm"
        android:layout_marginStart="40mm"
        android:layout_marginEnd="40mm">
        <TextView
            android:textSize="20dp"
            android:textColor="#ff333333"
            android:ellipsize="end"
            android:id="@+id/tv_meet_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="昵称昵称昵称昵称…"
            android:maxLength="8"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lin_sex"
            android:background="@drawable/bg_nv_bj"
            android:layout_width="79mm"
            android:layout_height="32mm"
            android:layout_marginStart="20mm">
            <ImageView
                android:id="@+id/image_sex"
                android:layout_width="18mm"
                android:layout_height="18mm"
                android:layout_marginTop="6mm"
                android:layout_marginBottom="6mm"
                android:src="@mipmap/image_nv"
                android:layout_marginStart="20mm"
                android:layout_marginEnd="4mm"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="20mm"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20mm"
        android:layout_marginStart="40mm"
        android:layout_marginEnd="40mm">
        <TextView
            android:textSize="13dp"
            android:textColor="#ff999999"
            android:id="@+id/country"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="所属国家名称"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <View
            android:background="#999999"
            android:layout_width="2mm"
            android:layout_height="20mm"
            android:layout_marginStart="12mm"
            android:layout_marginEnd="12mm"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#ff999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2小时前"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/re_hello"
        android:background="@drawable/bg_hy_add"
        android:layout_width="match_parent"
        android:layout_height="88mm"
        android:layout_marginTop="60mm"
        android:layout_marginBottom="40mm"
        android:layout_marginStart="40mm"
        android:layout_marginEnd="40mm">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/say_hello"
            android:drawablePadding="8mm"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:drawableStart="@mipmap/meet_cha"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/re_room"
        android:background="@drawable/bg_meet_room"
        android:layout_width="match_parent"
        android:layout_height="88mm"
        android:layout_marginBottom="40mm"
        android:layout_marginStart="40mm"
        android:layout_marginEnd="40mm">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_room"
            android:drawablePadding="8mm"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:drawableStart="@mipmap/meet_enter"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
    </RelativeLayout>
</LinearLayout>
