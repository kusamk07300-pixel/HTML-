<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@drawable/bg_room_info_card"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="170mm">
        <LinearLayout
            android:orientation="vertical"
            android:background="@mipmap/room_info_card_bg"
            android:layout_width="match_parent"
            android:layout_height="400mm"/>
        <ImageView
            android:id="@+id/image_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-170mm"/>
        <com.yy.yyeva.view.EvaAnimViewV3
            android:id="@+id/ev_card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-170mm"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:visibility="invisible"
                    android:layout_width="64mm"
                    android:layout_height="80mm"
                    android:layout_marginTop="24mm"
                    android:layout_marginStart="24mm">
                    <ImageView
                        android:layout_width="64mm"
                        android:layout_height="64mm"
                        android:src="@mipmap/image_value"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#ffffe37e"
                        android:gravity="center"
                        android:id="@+id/tv_likes"
                        android:background="@mipmap/iamge_dzbj"
                        android:layout_width="64mm"
                        android:layout_height="28mm"
                        android:text="0"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/image_question"
                    android:visibility="gone"
                    android:layout_width="44mm"
                    android:layout_height="44mm"
                    android:layout_marginTop="24mm"
                    android:src="@mipmap/iamge_question"
                    android:layout_marginEnd="24mm"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/image_information"
                    android:visibility="gone"
                    android:layout_width="44mm"
                    android:layout_height="44mm"
                    android:layout_marginTop="24mm"
                    android:src="@mipmap/iamge_information"
                    android:layout_marginEnd="20mm"
                    android:layout_toStartOf="@+id/image_question"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="22.5dp">
                <ImageView
                    android:id="@+id/iv_identity"
                    android:visibility="gone"
                    android:layout_width="40mm"
                    android:layout_height="40mm"
                    android:layout_marginEnd="5mm"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/base_text_color"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="昵称"
                    android:maxLines="1"/>
                <ImageView
                    android:id="@+id/iv_auth"
                    android:visibility="gone"
                    android:layout_width="40mm"
                    android:layout_height="40mm"
                    android:src="@mipmap/official_auth"
                    android:layout_marginStart="10mm"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10mm">
                <ImageView
                    android:id="@+id/iv_vip"
                    android:layout_width="wrap_content"
                    android:layout_height="32mm"
                    android:layout_marginEnd="12mm"/>
                <ImageView
                    android:id="@+id/iv_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/level_0"
                    android:layout_marginEnd="12mm"/>
                <ImageView
                    android:id="@+id/iv_level_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/level_author_0"
                    android:layout_marginEnd="12mm"/>
                <ImageView
                    android:id="@+id/wealth_level"
                    android:layout_width="wrap_content"
                    android:layout_height="32mm"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20mm">
                <ImageView
                    android:id="@+id/image_id"
                    android:visibility="gone"
                    android:layout_width="64mm"
                    android:layout_height="34mm"
                    android:layout_marginEnd="8mm"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/ll_copy"
                    android:background="@drawable/bg_4dd4abff_r12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="32mm"
                        android:layout_height="32mm"
                        android:src="@mipmap/my_id_pic"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#666666"
                        android:id="@+id/tv_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID："
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                    <ImageView
                        android:layout_width="32mm"
                        android:layout_height="32mm"
                        android:src="@mipmap/copy_b"/>
                    <View
                        android:background="#999999"
                        android:visibility="gone"
                        android:layout_width="2mm"
                        android:layout_height="28mm"
                        android:layout_marginStart="12mm"
                        android:layout_marginEnd="12mm"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/iv_iso"
                    android:visibility="gone"
                    android:layout_width="28mm"
                    android:layout_height="20mm"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="10mm"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_country"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"/>
            </LinearLayout>
            <LinearLayout
                android:paddingLeft="30mm"
                android:paddingRight="30mm"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="30mm">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@mipmap/bg_userinfo_card_medal"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="23dp"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20mm"
                        android:layout_marginTop="13mm"
                        android:layout_marginRight="20mm"
                        android:text="@string/my_medal"
                        android:layout_marginHorizontal="20mm"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/re_medal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14mm"/>
                </LinearLayout>
                <View
                    android:layout_width="10mm"
                    android:layout_height="0dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@mipmap/bg_userinfo_card_supporter"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="23dp"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20mm"
                        android:layout_marginTop="13mm"
                        android:layout_marginRight="20mm"
                        android:text="@string/supporter"
                        android:layout_marginHorizontal="20mm"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_user_card_gift_wall"
                android:layout_width="match_parent"
                android:layout_height="129mm"
                android:layout_marginLeft="30mm"
                android:layout_marginTop="10dp"
                android:layout_marginRight="30mm"
                android:layout_marginBottom="20mm"
                android:layout_marginHorizontal="30mm">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/base_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14mm"
                        android:text="@string/gift_wall"
                        android:layout_marginStart="30mm"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_gift"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20mm"
                        android:layout_marginStart="14mm"/>
                </LinearLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30mm"
                android:layout_marginTop="10dp"
                android:layout_marginRight="30mm"
                android:layout_marginHorizontal="30mm">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/space_cover"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/imgs_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12mm"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/lin_badge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20mm">
                <ImageView
                    android:id="@+id/badge_empty1"
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:src="@mipmap/medal_empty"
                    android:layout_marginEnd="16mm"/>
                <ImageView
                    android:id="@+id/badge1"
                    android:visibility="gone"
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:layout_marginEnd="16mm"/>
                <com.yy.yyeva.view.EvaAnimViewV3
                    android:id="@+id/ev_badge1"
                    android:visibility="gone"
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:layout_marginEnd="16mm"/>
                <ImageView
                    android:id="@+id/badge_empty2"
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:src="@mipmap/medal_empty"
                    android:layout_marginEnd="16mm"/>
                <ImageView
                    android:id="@+id/badge2"
                    android:visibility="gone"
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:layout_marginEnd="16mm"/>
                <com.yy.yyeva.view.EvaAnimViewV3
                    android:id="@+id/ev_badge2"
                    android:visibility="gone"
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:layout_marginEnd="16mm"/>
                <ImageView
                    android:id="@+id/badge_empty3"
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:src="@mipmap/medal_empty"/>
                <ImageView
                    android:id="@+id/badge3"
                    android:visibility="gone"
                    android:layout_width="64mm"
                    android:layout_height="64mm"/>
                <com.yy.yyeva.view.EvaAnimViewV3
                    android:id="@+id/ev_badge3"
                    android:visibility="gone"
                    android:layout_width="64mm"
                    android:layout_height="64mm"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:background="@mipmap/user_pk_bj"
                    android:visibility="gone"
                    android:layout_width="192mm"
                    android:layout_height="64mm">
                    <ImageView
                        android:id="@+id/image_pk"
                        android:layout_width="40mm"
                        android:layout_height="40mm"
                        android:layout_margin="12mm"
                        android:src="@mipmap/pk_icon"/>
                    <RatingBar
                        android:id="@+id/ra_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:rating="3"
                        android:stepSize="1"
                        style="@style/myRatingBar"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20mm"
                android:text="@string/my_relationship"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/lin_understand"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20mm"
                android:layout_marginBottom="40mm">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#ff999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无守护关系/无守护"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#ff57adfe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="了解守护&gt;"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="20mm"
                    android:textFontWeight="600"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/lin_guard"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20mm">
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/re_guard3"
                    android:visibility="gone"
                    android:layout_width="80mm"
                    android:layout_height="90mm"
                    android:layout_marginEnd="40mm">
                    <ImageView
                        android:id="@+id/imgs_guard_avatar3"
                        android:layout_width="80mm"
                        android:layout_height="80mm"
                        android:src="@mipmap/circle_logo"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/tv_num_guard3"
                        android:background="@drawable/live_profit_pink"
                        android:layout_width="match_parent"
                        android:layout_height="28mm"
                        android:text="LV1"
                        android:layout_alignParentBottom="true"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </RelativeLayout>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/re_guard2"
                    android:visibility="gone"
                    android:layout_width="80mm"
                    android:layout_height="90mm"
                    android:layout_marginEnd="40mm">
                    <ImageView
                        android:id="@+id/imgs_guard_avatar2"
                        android:layout_width="80mm"
                        android:layout_height="80mm"
                        android:src="@mipmap/circle_logo"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/tv_num_guard2"
                        android:background="@drawable/live_profit_pink"
                        android:layout_width="match_parent"
                        android:layout_height="28mm"
                        android:text="LV1"
                        android:layout_alignParentBottom="true"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </RelativeLayout>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/re_guard1"
                    android:layout_width="80mm"
                    android:layout_height="90mm">
                    <ImageView
                        android:id="@+id/imgs_guard_avatar1"
                        android:layout_width="80mm"
                        android:layout_height="80mm"
                        android:src="@mipmap/circle_logo"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/tv_num_guard1"
                        android:background="@drawable/live_profit_pink"
                        android:layout_width="match_parent"
                        android:layout_height="28mm"
                        android:text="LV1"
                        android:layout_alignParentBottom="true"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/lin_room"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40mm">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/lin_manage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/image_manage"
                        android:layout_width="64mm"
                        android:layout_height="64mm"
                        android:src="@mipmap/image_add_manage"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/base_text_color"
                        android:id="@+id/tv_manage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/set_management"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/lin_mute_mic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/iv_mic"
                        android:layout_width="64mm"
                        android:layout_height="64mm"
                        android:src="@mipmap/ic_jm"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/base_text_color"
                        android:id="@+id/tv_mic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forbidden_wheat"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/lin_mute_voice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/iv_mute_voice"
                        android:layout_width="64mm"
                        android:layout_height="64mm"
                        android:src="@mipmap/ic_jy"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/base_text_color"
                        android:id="@+id/tv_mute_voice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estoppel"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/line_bao_mic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/iv_down"
                        android:layout_width="64mm"
                        android:layout_height="64mm"
                        android:src="@mipmap/ic_bao"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/base_text_color"
                        android:id="@+id/tv_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/baomai"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/lin_kick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="64mm"
                        android:layout_height="64mm"
                        android:src="@mipmap/ic_kick"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/base_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kick_people"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/lin_function"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="104mm"
                android:layout_marginBottom="80mm">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/lin_collection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_user_card_follow"
                        android:layout_width="84dp"
                        android:layout_height="42dp">
                        <ImageView
                            android:id="@+id/image_collection"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@mipmap/ic_fllow"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_collection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/follow"
                            android:fontFamily="sans-serif-medium"
                            android:textFontWeight="600"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/lin_chat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_user_card_chat"
                        android:layout_width="84dp"
                        android:layout_height="42dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@mipmap/ic_message"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_chat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chat"
                            android:fontFamily="sans-serif-medium"
                            android:textFontWeight="600"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/lin_ta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_user_card_aite"
                        android:layout_width="84dp"
                        android:layout_height="42dp">
                        <ImageView
                            android:visibility="gone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@mipmap/ic_a"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#ff5a8c"
                            android:id="@+id/tv_ta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/circle_ta"
                            android:fontFamily="sans-serif-medium"
                            android:textFontWeight="600"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/lin_gift"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_user_card_info"
                        android:layout_width="84dp"
                        android:layout_height="42dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@mipmap/new_gift_room"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gift"
                            android:fontFamily="sans-serif-medium"
                            android:textFontWeight="600"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="180mm"
        android:layout_marginTop="80mm"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:id="@+id/re_1"
            android:layout_width="180mm"
            android:layout_height="180mm">
            <ImageView xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/image_avatar1"
                android:layout_width="140mm"
                android:layout_height="140mm"
                android:src="@mipmap/circle_logo"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                app:civ_border_color="#ffc295"
                app:civ_border_width="2mm"/>
            <ImageView
                android:id="@+id/svga_view"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.yy.yyeva.view.EvaAnimView
                android:id="@+id/ev_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/re_2"
            android:visibility="gone"
            android:layout_width="180mm"
            android:layout_height="180mm"
            android:layout_marginStart="20mm"
            android:layout_toEndOf="@+id/re_1">
            <ImageView
                android:id="@+id/image_avatar2"
                android:layout_width="120mm"
                android:layout_height="120mm"
                android:src="@mipmap/circle_logo"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                app:civ_border_color="#ef5b90"
                app:civ_border_width="4mm"/>
            <ImageView
                android:id="@+id/svga_view2"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/image_heart"
            android:visibility="gone"
            android:layout_width="120mm"
            android:layout_height="120mm"
            android:src="@mipmap/iamge_heart_rate"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
