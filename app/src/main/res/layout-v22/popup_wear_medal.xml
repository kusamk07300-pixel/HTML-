<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_manager_bj"
    android:layout_width="match_parent"
    android:layout_height="900mm">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="96mm">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/base_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wearing_medals"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="36mm"
            android:layout_height="36mm"
            android:src="@mipmap/mic_gb"
            android:layout_centerVertical="true"
            android:layout_marginEnd="28mm"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="136mm">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_completed"
            android:background="@drawable/bg_login_fac"
            android:layout_width="match_parent"
            android:layout_height="88mm"
            android:text="@string/define"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="40mm"
            android:layout_marginEnd="40mm"
            android:textFontWeight="600"/>
    </LinearLayout>
</LinearLayout>
