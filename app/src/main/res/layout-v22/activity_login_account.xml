<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rel_top"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@mipmap/logoin_bg"
        android:layout_width="match_parent"
        android:layout_height="328mm"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="321mm">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/splash_logo"
                    android:layout_width="@dimen/login_logo"
                    android:layout_height="@dimen/login_logo"
                    android:src="@mipmap/voice_logo"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="22dp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="47mm"
                    android:text="@string/get_start"
                    android:fontFamily="sans-serif-medium"
                    android:lineHeight="53mm"
                    android:textFontWeight="700"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7mm"
                    android:text="@string/sign_up_access"
                    android:lineHeight="17dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/login_spacing"
                    android:paddingRight="@dimen/login_spacing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="160mm"
                    android:layout_below="@+id/splash_logo">
                    <LinearLayout style="@style/login_input_parent_white_alpha">
                        <EditText
                            android:id="@+id/ed_id"
                            android:hint="@string/enter_account"
                            android:inputType="number"
                            android:textAlignment="viewStart"
                            android:layoutDirection="locale"
                            style="@style/login_input_white"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_marginTop="24mm"
                        style="@style/login_input_parent_white_alpha">
                        <EditText
                            android:id="@+id/ed_pass"
                            android:hint="@string/enter_password"
                            android:maxLength="8"
                            android:inputType="textPassword"
                            android:textAlignment="viewStart"
                            android:layoutDirection="locale"
                            style="@style/login_input_white"/>
                        <RelativeLayout
                            android:id="@+id/real_pass"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1">
                            <ImageView
                                android:id="@+id/imgs_pass"
                                android:layout_width="38mm"
                                android:layout_height="38mm"
                                android:src="@mipmap/icon_bxs"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_login"
                        android:layout_marginTop="48mm"
                        android:text="@string/login"
                        style="@style/login_btn"/>
                    <TextView
                        android:textSize="@dimen/login_base_text"
                        android:textColor="@color/white"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_account"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24mm"
                        android:text="@string/login_code"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/base_text_color"
                        android:layout_gravity="end"
                        android:id="@+id/tv_forget_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30mm"
                        android:text="@string/forget_password"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="63mm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:id="@+id/ll_other_login"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="45mm"
                        android:layout_marginBottom="16mm">
                        <ImageView
                            android:id="@+id/iv_f"
                            android:visibility="gone"
                            android:src="@mipmap/login_f"
                            style="@style/login_style_item"/>
                        <ImageView
                            android:id="@+id/login_g"
                            android:src="@mipmap/login_g"
                            style="@style/login_style_item"/>
                        <ImageView
                            android:id="@+id/iv_email"
                            android:visibility="gone"
                            android:src="@mipmap/login_email"
                            style="@style/login_style_item"/>
                        <ImageView
                            android:id="@+id/iv_phone"
                            android:src="@mipmap/login_pjone"
                            style="@style/login_style_item"/>
                        <ImageView
                            android:visibility="gone"
                            android:src="@mipmap/login_w"
                            style="@style/login_style_item"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:id="@+id/ll_user_agree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center"
                            android:id="@+id/ll_agree"
                            android:layout_width="60mm"
                            android:layout_height="60mm">
                            <ImageView
                                android:id="@+id/iv_agree"
                                android:layout_width="32mm"
                                android:layout_height="32mm"
                                android:src="@mipmap/login_no_choose"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/login_base_text"
                            android:textColor="#666666"
                            android:id="@+id/tv_protocol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_agrees"/>
                        <TextView
                            android:textSize="@dimen/login_base_text"
                            android:textColor="#666666"
                            android:id="@+id/tv_user"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/user_xy"/>
                        <TextView
                            android:textSize="@dimen/login_base_text"
                            android:textColor="#666666"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/and"
                            android:layout_marginStart="10mm"
                            android:layout_marginEnd="10mm"/>
                        <TextView
                            android:textSize="@dimen/login_base_text"
                            android:textColor="#666666"
                            android:id="@+id/tv_privacy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/user_xys"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
