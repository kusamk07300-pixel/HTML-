<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/page_top"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/base_text_color"
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/message"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="40mm"
                android:layout_marginEnd="30mm"
                android:textFontWeight="600"/>
            <RelativeLayout
                android:layout_gravity="end"
                android:id="@+id/iv_friends"
                android:paddingLeft="40mm"
                android:paddingTop="30mm"
                android:paddingRight="40mm"
                android:paddingBottom="20mm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="40mm">
                <ImageView
                    android:layout_width="44mm"
                    android:layout_height="44mm"
                    android:src="@mipmap/users_list"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_new_friend"
            android:paddingTop="20mm"
            android:paddingBottom="20mm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="28mm"
            android:paddingEnd="28mm">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@mipmap/eva_friends"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24mm">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#812fff"
                    android:id="@+id/tv_friends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/friend_application"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"/>
                <com.tencent.qcloud.tuikit.timcommon.component.UnreadCountTextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/unread_count_friends"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16mm"
                    android:layout_toEndOf="@+id/tv_friends"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14mm"
                    android:text="@string/resver_friends"
                    android:layout_below="@+id/tv_friends"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_notice"
            android:paddingTop="20mm"
            android:paddingBottom="20mm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="28mm"
            android:paddingEnd="28mm">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@mipmap/eva_sys"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24mm">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#812fff"
                    android:id="@+id/tv_sys"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/official_notification"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"/>
                <com.tencent.qcloud.tuikit.timcommon.component.UnreadCountTextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/conversation_unread"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16mm"
                    android:layout_toEndOf="@+id/tv_sys"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14mm"
                    android:text="@string/resver_sys"
                    android:layout_below="@+id/tv_sys"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_customer"
            android:paddingTop="20mm"
            android:paddingBottom="20mm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="28mm"
            android:paddingEnd="28mm">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@mipmap/event_kefu"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24mm">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#812fff"
                    android:id="@+id/tv_customer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_service"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"/>
                <com.tencent.qcloud.tuikit.timcommon.component.UnreadCountTextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/customer_unread"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16mm"
                    android:layout_toEndOf="@+id/tv_customer"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14mm"
                    android:text="@string/app_customer"
                    android:layout_below="@+id/tv_customer"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lin_center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="112mm"
            android:layout_marginTop="40mm"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm">
            <ImageView
                android:layout_width="112mm"
                android:layout_height="112mm"
                android:src="@mipmap/chat_activity_center"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#ffffb80c"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_center"
                android:drawablePadding="8mm"
                android:drawableEnd="@mipmap/chat_v"
                android:layout_marginStart="20mm"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lin_reward"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="112mm"
            android:layout_marginTop="40mm"
            android:layout_marginBottom="20mm"
            android:layout_marginStart="28mm"
            android:layout_marginEnd="28mm">
            <ImageView
                android:layout_width="112mm"
                android:layout_height="112mm"
                android:src="@mipmap/chat_reward"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8mm"
                android:layout_weight="1"
                android:layout_marginStart="20mm">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="#ffffb80c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reward"
                    android:drawablePadding="8mm"
                    android:drawableEnd="@mipmap/chat_v"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#ff999999"
                    android:ellipsize="end"
                    android:id="@+id/tv_reward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14mm"
                    android:text=""
                    android:maxLines="1"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.3">
                <TextView
                    android:textSize="11dp"
                    android:textColor="#ff999999"
                    android:id="@+id/tv_reward_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_alignParentEnd="true"/>
                <com.tencent.qcloud.tuikit.timcommon.component.UnreadCountTextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/unread_count_reward"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20mm"
                    android:text="0"
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/tui_conversation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</RelativeLayout>
