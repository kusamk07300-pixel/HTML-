<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_redbag_list"
    android:paddingLeft="20mm"
    android:paddingRight="20mm"
    android:layout_width="match_parent"
    android:layout_height="140mm"
    android:layout_marginBottom="20mm"
    android:layout_marginStart="28mm"
    android:layout_marginEnd="28mm"
    android:paddingHorizontal="20mm">
    <RelativeLayout
        android:background="@mipmap/image_treasure"
        android:layout_width="120mm"
        android:layout_height="120mm">
        <net.babycat.live.platform.util.TimeCountDownTextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_time"
            android:background="@drawable/bg_time_bj"
            android:layout_width="match_parent"
            android:layout_height="40mm"
            android:layout_marginLeft="12mm"
            android:layout_marginRight="12mm"
            android:layout_marginBottom="6mm"
            android:text="@string/ended"
            android:layout_alignParentBottom="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="12mm"
            android:textFontWeight="600"/>
    </RelativeLayout>
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/civ_header"
        android:layout_width="80mm"
        android:layout_height="80mm"
        android:src="@mipmap/circle_logo"
        android:layout_marginStart="16mm"
        app:civ_border_color="@color/white"
        app:civ_border_width="1dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/base_text_color"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Name"
        android:maxLines="1"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="8mm"
        android:textFontWeight="600"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="24mm"
            android:layout_height="24mm"
            android:src="@mipmap/jin"
            android:layout_marginEnd="4mm"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffef324c"
            android:id="@+id/tv_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
    </LinearLayout>
</LinearLayout>
