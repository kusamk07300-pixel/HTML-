<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lin_pk_view"
        android:layout_width="match_parent"
        android:layout_height="568mm">
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.tencent.rtmp.ui.TXCloudVideoView
                android:id="@+id/live_pk_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/ima_pk"
                android:layout_width="200mm"
                android:layout_height="200mm"
                android:layout_marginBottom="64mm"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/image_pk_close"
                android:visibility="visible"
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:layout_marginTop="10mm"
                android:src="@mipmap/close_white_new"
                android:layout_marginStart="20mm"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.tencent.rtmp.ui.TXCloudVideoView
                android:id="@+id/live_pk_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/ima_pk2"
                android:layout_width="200mm"
                android:layout_height="200mm"
                android:layout_marginBottom="64mm"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/lin_user_pk"
                android:background="@drawable/bg_live_pk_info"
                android:layout_width="wrap_content"
                android:layout_height="44mm"
                android:layout_marginTop="10mm"
                android:layout_marginEnd="20mm"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/imgs_avatar"
                    android:layout_width="32mm"
                    android:layout_height="32mm"
                    android:src="@mipmap/voice_logo"
                    android:layout_marginStart="6mm"/>
                <net.babycat.live.platform.widget.view.MarqueeTextview
                    android:textSize="13dp"
                    android:textColor="#ffffffff"
                    android:ellipsize="marquee"
                    android:id="@+id/tv_name"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="144mm"
                    android:layout_height="wrap_content"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:layout_marginStart="6mm"
                    android:layout_marginEnd="9mm"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/lin_pk"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-70mm"
        android:layout_below="@+id/lin_pk_view">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="70mm">
                <ImageView
                    android:layout_width="60mm"
                    android:layout_height="60mm"
                    android:src="@mipmap/pk_red_ic"
                    android:layout_marginStart="7mm"/>
                <ImageView
                    android:layout_width="60mm"
                    android:layout_height="60mm"
                    android:src="@mipmap/pk_blue_ic"
                    android:layout_marginStart="7mm"
                    android:layout_marginEnd="7mm"
                    android:layout_alignParentEnd="true"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@mipmap/countdown_bj"
                    android:layout_width="240mm"
                    android:layout_height="50mm"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:id="@+id/image_pk"
                        android:visibility="visible"
                        android:layout_width="34mm"
                        android:layout_height="34mm"
                        android:src="@mipmap/vs_pk"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="20mm"/>
                    <net.babycat.live.platform.util.TimeCountDownTextView
                        android:textSize="13dp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:id="@+id/countdown"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="9mm"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/tv_pk"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/start"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/real_progress"
                android:layout_width="match_parent"
                android:layout_height="40mm">
                <ProgressBar
                    android:id="@+id/pro_pk"
                    android:background="#009dff"
                    android:layout_width="match_parent"
                    android:layout_height="40mm"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/layer_list_progress_pk"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>
                <net.babycat.live.platform.widget.view.GifView xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/gif_view"
                    android:layout_width="200mm"
                    android:layout_height="35mm"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    app:progress_gif="@raw/pking"/>
                <ImageView
                    android:layout_width="30mm"
                    android:layout_height="30mm"
                    android:src="@mipmap/icon_diamond"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="5mm"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/tv_pk_left_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="50mm"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_pk_right_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="50mm"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:layout_width="30mm"
                    android:layout_height="30mm"
                    android:src="@mipmap/icon_diamond"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="5mm"
                    android:layout_marginEnd="5mm"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_pk_mute"
        android:visibility="gone"
        android:layout_width="36mm"
        android:layout_height="36mm"
        android:layout_marginTop="40mm"
        android:src="@mipmap/pk_mute"
        android:layout_marginEnd="12mm"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:background="@mipmap/pk_top123_bg"
        android:layout_width="match_parent"
        android:layout_height="110mm"
        android:layout_below="@+id/lin_pk">
        <ImageView
            android:layout_width="98mm"
            android:layout_height="60mm"
            android:src="@mipmap/vs_pk"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="71mm"
            android:layout_marginLeft="58mm"
            android:layout_marginRight="58mm"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="58mm">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="126mm"
                android:layout_alignParentStart="true">
                <RelativeLayout
                    android:layout_width="66mm"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="30mm">
                    <ImageView
                        android:id="@+id/iv_left_1"
                        android:layout_width="66mm"
                        android:layout_height="66mm"
                        android:src="@mipmap/live_empty"/>
                    <ImageView
                        android:layout_width="25mm"
                        android:layout_height="25mm"
                        android:src="@mipmap/pk_ranking1"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="66mm"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="30mm">
                    <ImageView
                        android:id="@+id/iv_left_2"
                        android:layout_width="66mm"
                        android:layout_height="66mm"
                        android:src="@mipmap/live_empty"/>
                    <ImageView
                        android:layout_width="25mm"
                        android:layout_height="25mm"
                        android:src="@mipmap/pk_ranking2"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="66mm"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="20mm">
                    <ImageView
                        android:id="@+id/iv_left_3"
                        android:layout_width="66mm"
                        android:layout_height="66mm"
                        android:src="@mipmap/live_empty"/>
                    <ImageView
                        android:layout_width="25mm"
                        android:layout_height="25mm"
                        android:src="@mipmap/pk_ranking3"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </LinearLayout>
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tv_restart"
                android:background="@drawable/bg_new_family_but"
                android:paddingTop="4mm"
                android:paddingBottom="4mm"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restart"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:paddingStart="10mm"
                android:paddingEnd="10mm"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true">
                <RelativeLayout
                    android:layout_width="66mm"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="30mm">
                    <ImageView
                        android:id="@+id/iv_right_3"
                        android:layout_width="66mm"
                        android:layout_height="66mm"
                        android:src="@mipmap/live_empty"/>
                    <ImageView
                        android:layout_width="25mm"
                        android:layout_height="25mm"
                        android:src="@mipmap/pk_ranking3_blue"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="66mm"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="30mm">
                    <ImageView
                        android:id="@+id/iv_right_2"
                        android:layout_width="66mm"
                        android:layout_height="66mm"
                        android:src="@mipmap/live_empty"/>
                    <ImageView
                        android:layout_width="25mm"
                        android:layout_height="25mm"
                        android:src="@mipmap/pk_ranking2_blue"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="66mm"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/iv_right_1"
                        android:layout_width="66mm"
                        android:layout_height="66mm"
                        android:src="@mipmap/live_empty"/>
                    <ImageView
                        android:layout_width="25mm"
                        android:layout_height="25mm"
                        android:src="@mipmap/pk_ranking1_blue"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
