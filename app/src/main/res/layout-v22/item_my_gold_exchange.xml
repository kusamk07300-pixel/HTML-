<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_white_r12"
    android:layout_width="match_parent"
    android:layout_height="120mm"
    android:layout_marginBottom="24mm"
    android:paddingStart="28mm"
    android:paddingEnd="28mm">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:layout_width="40mm"
            android:layout_height="40mm"
            android:src="@mipmap/icon_diamond"
            android:layout_marginEnd="12mm"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/subtitle_text_color"
            android:id="@+id/tv_ticks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:layout_width="40mm"
            android:layout_height="40mm"
            android:src="@mipmap/jin"
            android:layout_marginEnd="12mm"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/base_text_color"
            android:id="@+id/tv_gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
    </LinearLayout>
</LinearLayout>
