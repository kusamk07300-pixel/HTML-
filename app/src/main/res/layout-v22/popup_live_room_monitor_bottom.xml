<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_user_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="96mm">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/base_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_monitor"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10mm"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/base_text_color"
            android:id="@+id/cycle_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Poll Time:10s"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10mm"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/base_text_color"
            android:id="@+id/tv_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="30mm"
            android:layout_toStartOf="@+id/iv_close"
            android:textFontWeight="600"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="44mm"
            android:layout_height="44mm"
            android:src="@mipmap/mic_gb"
            android:layout_centerVertical="true"
            android:layout_marginEnd="28mm"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#999"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10mm"
        android:layout_marginStart="20mm"
        android:layout_marginEnd="20mm"/>
    <com.tencent.rtmp.ui.TXCloudVideoView
        android:id="@+id/live_cloud_view_main"
        android:background="#666666"
        android:layout_width="match_parent"
        android:layout_height="900mm"
        android:layout_marginTop="20mm"
        android:layout_marginStart="100mm"
        android:layout_marginEnd="100mm"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="100mm"
        android:layout_marginTop="100mm"
        android:layout_marginBottom="50mm"
        android:layout_marginStart="15mm"
        android:layout_marginEnd="20mm">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_close_room"
            android:background="@drawable/bg_btn_gradint_56"
            android:layout_width="0dp"
            android:layout_height="96mm"
            android:text="@string/new_close_room"
            android:layout_weight="1"
            android:layout_marginEnd="15mm"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_ban_user"
            android:background="@drawable/bg_login_gradint_input_56"
            android:layout_width="0dp"
            android:layout_height="96mm"
            android:text="@string/close_live_ban_user"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
