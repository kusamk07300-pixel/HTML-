<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="120mm">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:paddingStart="20mm"
            android:paddingEnd="20mm">
            <ImageView
                android:id="@+id/iv_header"
                android:layout_width="80mm"
                android:layout_height="80mm"
                android:src="@mipmap/image_user"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20mm">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/base_text_color"
                    android:ellipsize="end"
                    android:id="@+id/tv_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/second_text_color"
                    android:id="@+id/tv_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4mm"
                    android:text="ID：00000000"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/base_text_color"
            android:id="@+id/tv_valid_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/base_text_color"
            android:id="@+id/tv_valid_hours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/base_text_color"
            android:id="@+id/tv_coins_num"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            android:layout_marginEnd="20mm"
            android:textFontWeight="600"/>
    </LinearLayout>
    <View
        android:background="#f3f3f3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="136mm"/>
</LinearLayout>
