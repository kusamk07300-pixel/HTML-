<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/page_top"
        layout="@layout/common_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_white_r20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30mm"
        android:layout_marginRight="30mm"
        android:layout_marginBottom="25mm"
        android:layout_marginHorizontal="30mm">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/rl_pass"
            android:layout_width="match_parent"
            android:layout_height="@dimen/my_set_height"
            android:paddingStart="@dimen/home_space"
            android:paddingEnd="@dimen/home_space">
            <ImageView
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:src="@mipmap/change_password"/>
            <TextView
                android:textSize="@dimen/my_set_title"
                android:textColor="@color/base_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_change_password"
                android:layout_centerVertical="true"
                android:layout_marginStart="15mm"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1mm"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="@dimen/my_set_icon"
                android:layout_height="@dimen/my_set_icon"
                android:src="@mipmap/go_back"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/rl_delete_account"
            android:layout_width="match_parent"
            android:layout_height="@dimen/my_set_height"
            android:layout_marginTop="1mm"
            android:paddingStart="@dimen/home_space"
            android:paddingEnd="@dimen/home_space">
            <ImageView
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:src="@mipmap/del_acc_po"/>
            <TextView
                android:textSize="@dimen/my_set_title"
                android:textColor="@color/base_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_delete_account"
                android:layout_centerVertical="true"
                android:layout_marginStart="15mm"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1mm"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="@dimen/my_set_icon"
                android:layout_height="@dimen/my_set_icon"
                android:src="@mipmap/go_back"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/rl_delete_policy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/my_set_height"
            android:layout_marginTop="1mm"
            android:paddingStart="@dimen/home_space"
            android:paddingEnd="@dimen/home_space">
            <ImageView
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:src="@mipmap/delete_agreement"/>
            <TextView
                android:textSize="@dimen/my_set_title"
                android:textColor="@color/base_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_delete_account_policy"
                android:layout_centerVertical="true"
                android:layout_marginStart="15mm"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1mm"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="@dimen/my_set_icon"
                android:layout_height="@dimen/my_set_icon"
                android:src="@mipmap/go_back"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
